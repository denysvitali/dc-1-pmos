+static void mtk_ovl_save_handoff_qos(struct mtk_disp_ovl *ovl)
+{
+	unsigned int i;
+
+	if (!ovl->data->preserve_handoff_qos || ovl->qos_saved)
+		return;
+
+	/* Save only policy that has passed the first-frame integrity checks. */
+	ovl->qos_greq = readl(ovl->regs + DISP_REG_OVL_RDMA_GREQ_NUM);
+	ovl->qos_greq_urg = readl(ovl->regs + DISP_REG_OVL_RDMA_GREQ_URG_NUM);
+	for (i = 0; i < ovl->data->layer_nr; i++) {
+		ovl->qos_buf_low[i] = readl(ovl->regs + DISP_REG_OVL_RDMA_BUF_LOW(i));
+		ovl->qos_buf_high[i] = readl(ovl->regs + DISP_REG_OVL_RDMA_BUF_HIGH(i));
+	}
+	ovl->qos_output_clamp = readl(ovl->regs + DISP_REG_OVL_DATAPATH_CON) &
+				OVL_OUTPUT_CLAMP;
+	ovl->qos_saved = true;
+}
+
+static int mtk_ovl_restore_qos_reg(struct mtk_disp_ovl *ovl, u32 offset, u32 value)
+{
+	writel(value, ovl->regs + offset);
+	if (readl(ovl->regs + offset) != value)
+		return dev_err_probe(ovl->dev, -EIO,
+				     "Failed to restore OVL QoS register %#x\n", offset);
+	return 0;
+}
+
 int mtk_ovl_clk_enable(struct device *dev)
 {
 	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
+	u32 reg;
+	unsigned int i;
+	int ret;
 
-	return clk_prepare_enable(ovl->clk);
+	ret = clk_prepare_enable(ovl->clk);
+	if (ret || !ovl->qos_saved)
+		return ret;
+
+	/* DISP power loss resets request limits and pre-ultra thresholds. */
+	ret = mtk_ovl_restore_qos_reg(ovl, DISP_REG_OVL_RDMA_GREQ_NUM, ovl->qos_greq);
+	if (ret)
+		goto err_clk_disable;
+	ret = mtk_ovl_restore_qos_reg(ovl, DISP_REG_OVL_RDMA_GREQ_URG_NUM,
+				      ovl->qos_greq_urg);
+	if (ret)
+		goto err_clk_disable;
+	for (i = 0; i < ovl->data->layer_nr; i++) {
+		ret = mtk_ovl_restore_qos_reg(ovl, DISP_REG_OVL_RDMA_BUF_LOW(i),
+					      ovl->qos_buf_low[i]);
+		if (ret)
+			goto err_clk_disable;
+		ret = mtk_ovl_restore_qos_reg(ovl, DISP_REG_OVL_RDMA_BUF_HIGH(i),
+					      ovl->qos_buf_high[i]);
+		if (ret)
+			goto err_clk_disable;
+	}
+	reg = readl(ovl->regs + DISP_REG_OVL_DATAPATH_CON);
+	reg = (reg & ~OVL_OUTPUT_CLAMP) | ovl->qos_output_clamp;
+	ret = mtk_ovl_restore_qos_reg(ovl, DISP_REG_OVL_DATAPATH_CON, reg);
+	if (!ret)
+		return 0;
+
+err_clk_disable:
+	clk_disable_unprepare(ovl->clk);
+	return ret;
 }
 
 void mtk_ovl_clk_disable(struct device *dev)
@@ -1228,6 +1301,7 @@ int mtk_ovl_handoff_wait_for_fme(struct device *dev, u32 fme_seq)
 
 	dev_info(dev, "OVL first frame complete: seq=%u status=%#x flow=%#x\n",
 		 atomic_read(&ovl->fme_seq), irq_status, flow);
