# Register shallow architectural WFI so s2idle can freeze the tick and
# timekeeping. Keep the running DT, periodic awake tick and PSCI policy.
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_JAGAR_CPUIDLE=y

# Load the PMIC alarm RTC after the built-in S35390A timekeeping RTC.
CONFIG_RTC_DRV_MT6397=m
