# USB 2.0 host peripherals behind USB-C hubs and docks.
#
# The DC-1 has no xHCI/USB3 or Thunderbolt host controller, but USB 2.0
# peripherals and a dock's USB 2.0 Ethernet fallback are usable once the
# hub reports them. Keep these built in: the installed kernel is also the
# recovery host path, and no module loader is available in the minimal
# initramfs.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_SMSC95XX=y
