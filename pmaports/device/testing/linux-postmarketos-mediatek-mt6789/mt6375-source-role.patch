+static int mt6375_set_boost_param(struct mt6375_charger *charger,
+				   bool boost_mode)
+{
+	static const unsigned int regs[] = {
+		MT6375_REG_CHG_TOP2,
+		MT6375_REG_CHG_DUMY0,
+		MT6375_REG_CHG_HD_BUCK5,
+		MT6375_REG_CHG_VSYS,
+	};
+	static const unsigned int masks[] = {
+		GENMASK(7, 6),
+		GENMASK(1, 0),
+		GENMASK(7, 6),
+		BIT(7),
+	};
+	static const unsigned int buck[] = { 0x01, 0x00, 0x01, 0x01 };
+	static const unsigned int boost_values[] = { 0x00, 0x03, 0x03, 0x00 };
+	unsigned int i;
+	int ret;
+
+	ret = regmap_write(charger->regmap, MT6375_REG_TM_PAS_CODE1, 0x69);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		unsigned int value = (boost_mode ? boost_values : buck)[i];
+
+		value <<= __ffs(masks[i]);
+		ret = regmap_update_bits(charger->regmap, regs[i], masks[i], value);
+		if (ret)
+			break;
+	}
+
+	/* Hidden-mode access is intentionally one-shot. */
+	if (regmap_write(charger->regmap, MT6375_REG_TM_PAS_CODE1, 0))
+		dev_warn(regmap_get_device(charger->regmap),
+			 "failed to relock MT6375 boost parameters\n");
+	return ret;
+}
+
+static int mt6375_charger_set_source(void *data, bool source)
+{
+	struct mt6375_charger *charger = data;
+	int ret = 0;
+
+	mutex_lock(&charger->otg_lock);
+	if (charger->otg_enabled == source)
+		goto out;
+
+	if (source) {
+		/* 5.0 V: 4.85 V + 6 * 25 mV; 500 mA is intentionally conservative. */
+		ret = regmap_update_bits(charger->regmap, MT6375_REG_OTG_LBP,
+					 MT6375_OTG_LBP_MASK, 4);
+		if (!ret)
+			ret = regmap_update_bits(charger->regmap, MT6375_REG_OTG_V,
+						 MT6375_OTG_V_MASK, 6);
+		if (!ret)
+			ret = regmap_update_bits(charger->regmap, MT6375_REG_OTG_C,
+						 MT6375_OTG_C_MASK, 0);
+		if (!ret)
+			ret = mt6375_set_boost_param(charger, true);
+		if (!ret)
+			ret = regmap_update_bits(charger->regmap,
+						 MT6375_REG_CHG_TOP1,
+						 MT6375_OTG_EN, MT6375_OTG_EN);
+		if (ret)
+			mt6375_set_boost_param(charger, false);
+		else
+			charger->otg_enabled = true;
+	} else {
+		ret = regmap_update_bits(charger->regmap, MT6375_REG_CHG_TOP1,
+					 MT6375_OTG_EN, 0);
+		if (!ret)
+			ret = mt6375_set_boost_param(charger, false);
+		if (!ret)
+			charger->otg_enabled = false;
+	}
+out:
+	mutex_unlock(&charger->otg_lock);
+	return ret;
 }
 
