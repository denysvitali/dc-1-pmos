maintainer="Denys Vitali <denys@denv.it>"
pkgname=linux-postmarketos-mediatek-mt6789
pkgver=7.2_rc5_git20260819
pkgrel=61
pkgdesc="Mainline-based kernel fork for MediaTek MT6789/MT8781 devices"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-mediatek-mt6789"
url="https://github.com/denysvitali/dc-1-linux-kernel"
license="GPL-2.0-only"
subpackages="$pkgname-modules"
# One transaction must install the matching module tree with every kernel.
depends="$pkgname-modules=$pkgver-r$pkgrel"
options="!check !strip !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bash
	bc
	bison
	ccache
	clang20
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	lld20
	llvm20
	openssl-dev
	pahole
	perl
	python3
	zstd
"

_repository="dc-1-linux-kernel"
_commit="7cc767cd0cff39b77e252f26c9450d035c17b038"
# The kernel source tarball supplies the base config. The config used to be
# fetched separately from raw.githubusercontent.com under a commit-independent
# filename (config-$_flavor.$arch), which collided with the persisted distfiles
# cache: after a kernel pin bump the cached old config failed the new
# sha512sum and abuild refused it. The tarball already contains the exact
# config (and is itself pinned by sha512sum), so copy it out of there instead
# of maintaining a second, cache-fragile fetch.
source="
	$pkgname-$_commit.tar.gz::https://github.com/denysvitali/$_repository/archive/$_commit.tar.gz
	sdcard.config
	latency.config
	usb-host.config
	jagar-performance.patch
	mt6375-source-role.patch
"
builddir="$srcdir/$_repository-$_commit"

_check_kernel_config() {
	local config=$1 fragment setting
	for setting in \
		CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y \
		'# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set' \
		'# CONFIG_SLUB_TINY is not set' \
		CONFIG_COMPACTION=y CONFIG_CC_IS_CLANG=y CONFIG_LD_IS_LLD=y; do
		grep -qxF "$setting" "$config" || {
			error "required kernel setting missing: $setting ($config)"
			return 1
		}
	done
	for setting in CLANG LLD; do
		grep -qxE "CONFIG_${setting}_VERSION=20[0-9]{4}" "$config" || {
			error "required kernel compiler/linker: $setting 20 ($config)"
			return 1
		}
	done
	for fragment in sdcard.config latency.config usb-host.config; do
		while IFS= read -r setting; do
			case "$setting" in
				CONFIG_*=y|CONFIG_*=m)
					grep -qxF "$setting" "$config" || {
						error "required kernel support missing ($fragment): $setting"
						return 1
					}
					;;
			esac
		done < "$srcdir/$fragment"
	done
}

prepare() {
	default_prepare
	# Alpine's LLVM 20 layout is mixed: clang20/llvm20 ship versioned names
	# plus /usr/lib/llvm20/bin, while lld20 owns only the unversioned
	# /usr/bin/ld.lld. These checks fail the build early (and silently --
	# keep them in sync with the make invocations below).
	command -v clang-20 >/dev/null
	command -v ld.lld >/dev/null
	test -x /usr/lib/llvm20/bin/llvm-ar
	cp "$builddir/arch/arm64/configs/jagar_defconfig" .config
	# Storage and recovery USB stay built in; optional peripherals are modules.
	# Check exact y/m values after Kconfig resolves all dependencies.
	for fragment in sdcard.config latency.config usb-host.config; do
		while IFS= read -r setting; do
			case "$setting" in
				CONFIG_*=y) scripts/config --enable "${setting%=y}" ;;
				CONFIG_*=m) scripts/config --module "${setting%=m}" ;;
			esac
		done < "$srcdir/$fragment"
	done
	make ARCH="$_carch" LLVM=/usr/lib/llvm20/bin/ \
		LD=/usr/bin/ld.lld HOSTLD=/usr/bin/ld.lld olddefconfig
	_check_kernel_config .config || return 1
}

build() {
	unset LDFLAGS
	rm -f .config.kernel
	_check_kernel_config .config || return 1

	# ccache is routed in EXPLICITLY through CC/HOSTCC, not through PATH.
	# Alpine's ccache package installs /usr/lib/ccache/bin symlinks for cc,
	# gcc, g++, c++, c89, c99, cpp and the x86_64-alpine-linux-musl-* triple
	# only -- there is no clang or clang-20 symlink. pmbootstrap puts that
	# directory first in PATH, so an LLVM build looks cached and is not:
	# every run compiles from scratch while the cache stays empty.
	#
	# LLVM= uses kbuild's directory-prefix form because Alpine ships no
	# ld.lld-20: lld20 owns the unversioned /usr/bin/ld.lld, so LD/HOSTLD
	# are overridden explicitly.
	#
	# HOSTCC is clang too. LLVM= switches the host toolchain to LLVM as
	# well, so a gcc HOSTCC ends up driving lld and dies building fixdep.
	#
	# CCACHE_DIR is set explicitly: pmbootstrap symlinks /home/pmos/.ccache
	# to its persisted cache mount but never exports CCACHE_DIR, and ccache 4
	# otherwise prefers $XDG_CACHE_HOME/ccache -- which is inside the
	# throwaway chroot.
	export CCACHE_DIR="/home/pmos/.ccache"
	export CCACHE_BASEDIR="$srcdir"
	# 4G leaves room under the 10 GB per-repository GitHub cache budget once
	# the distfiles are counted.
	export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-4G}"
	# Compare compilers by content: an identical clang reinstalled in a fresh
	# chroot must not invalidate the whole cache on mtime alone.
	export CCACHE_COMPILERCHECK="content"
	# A fresh source extraction has fresh timestamps on every run, so without
	# these the hit rate is zero no matter how the cache is keyed. The
	# timestamp macros are safe here because KBUILD_BUILD_TIMESTAMP below is
	# pinned rather than taken from the wall clock.
	export CCACHE_SLOPPINESS="time_macros,include_file_mtime,include_file_ctime,file_stat_matches,pch_defines,system_headers"

	# Kernel + modules with the boot-proven clang-20/LLVM boundary. This is
	# the memory-heavy vmlinux link (Image.gz); it is built first, separate
	# from the DTB pass below, so the two never contend for the runner.
	make ARCH="$_carch" LLVM=/usr/lib/llvm20/bin/ \
		LD=/usr/bin/ld.lld \
		HOSTLD=/usr/bin/ld.lld \
		CC="ccache clang-20" \
		HOSTCC="ccache clang-20" \
		KBUILD_BUILD_TIMESTAMP="2026-08-17 08:27:49 UTC" \
		KBUILD_BUILD_USER="postmarketos" \
		KBUILD_BUILD_HOST="builder" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz modules || return 1
	# The serial gcc-host DTB pass runs kbuild on the same .config and can
	# change toolchain-derived values (e.g. CONFIG_LD_IS_LLD), so package the
	# config that actually produced the kernel image, not the post-DTB one.
	_check_kernel_config .config || return 1
	cp .config .config.kernel || return 1

	# Device trees, in a post-kernel pass with a gcc HOSTCC. dtbs builds the
	# bundled scripts/dtc/{dtc,fdtoverlay} host tools -- the "OVL" step that
	# applies the mt7986a/mt7988a/mt8395 overlay composites -- and compiles no
	# kernel C, so only HOSTCC matters here. clang-20 miscompiles fdtoverlay
	# such that the OVL step fails intermittently (9 of 11 CI runs) while the
	# same source builds cleanly with gcc/clang-19. The clang-20 HOSTCC
	# requirement above is a property of the LLVM= kernel build (fixdep + lld),
	# not of these host tools. Serial (-j1) also removes any parallel overlay
	# race. The boot image consumes exactly one of these dtbs
	# (mt8781-daylight-jagar.dtb; see scripts/export-artifacts.sh), but kbuild
	# has no single-subdir-dtb target, so build the set, serially.
	make ARCH="$_carch" \
		CC="ccache clang-20" \
		HOSTCC="gcc" \
		-j1 dtbs

	# A positive control for the cache itself. A build that bypasses ccache
	# produces a green package, an empty cache and a permanently cold build,
	# which is indistinguishable from "working" unless something asserts it.
	ccache --show-stats
	local calls
	calls=$(ccache --print-stats |
		awk '$1=="direct_cache_hit"||$1=="preprocessed_cache_hit"||$1=="cache_miss" { t+=$2 } END { print t+0 }')
	if [ "$calls" -eq 0 ]; then
		error "ccache saw zero compiles -- the build is bypassing it entirely"
		return 1
	fi
	msg "ccache handled $calls compiles"
}

package() {
	_check_kernel_config .config.kernel || return 1
	mkdir -p "$pkgdir"/boot
	install -Dm644 arch/$_carch/boot/Image.gz "$pkgdir"/boot/vmlinuz

	# Same compiler command as build()'s kernel pass: a different CC here would
	# make kbuild reconsider objects it already has and recompile them uncached.
	make modules_install \
		ARCH="$_carch" \
		LLVM=/usr/lib/llvm20/bin/ \
		LD=/usr/bin/ld.lld \
		HOSTLD=/usr/bin/ld.lld \
		CC="ccache clang-20" \
		HOSTCC="ccache clang-20" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	# Install the already-built dtbs. dtbs_install needs no compiler: it just
	# copies the blobs produced by build()'s dtbs pass.
	make dtbs_install \
		ARCH="$_carch" \
		CC="ccache clang-20" \
		HOSTCC="gcc" \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	# The Mali-G57 GPU is held behind a runtime OF overlay (not a cold-DT
	# entry), because probing it at boot would walk the MFG power domains
	# before they are safe. mt6789-live-gpu-overlay.ko requests this exact
	# overlay at load time via request_firmware_direct(), so it must live in
	# /lib/firmware/mediatek/ -- not /boot/dtbs, where dtbs_install puts it.
	# It is a compiled device-tree overlay from the kernel source (GPL), not a
	# proprietary blob; the driver pins its size + SHA-256 and refuses any
	# other content. See drivers/pmdomain/mediatek/mt6789-live-gpu-overlay.c.
	install -Dm644 \
		arch/$_carch/boot/dts/mediatek/mt8781-daylight-jagar-live-gpu-probe.dtbo \
		"$pkgdir"/lib/firmware/mediatek/mt8781-daylight-jagar-live-gpu-probe.dtbo

	# The audio bridge's overlay, loaded the same way by
	# drivers/pmdomain/mediatek/mt6789-live-audio-overlay.c: it adds the AUDIO
	# power domain the shipped DT asks for and nothing provides, which is what
	# lets the AFE probe and the sound card appear.
	install -Dm644 \
		arch/$_carch/boot/dts/mediatek/mt8781-daylight-jagar-live-audio-probe.dtbo \
		"$pkgdir"/lib/firmware/mediatek/mt8781-daylight-jagar-live-audio-probe.dtbo

	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	install -Dm644 .config.kernel "$pkgdir/usr/share/kernel/$_flavor/config"
}

modules() {
	pkgdesc="Loadable drivers for the DC-1 kernel"
	depends="kmod linux-firmware-rtl_nic"
	# Include modules.dep/alias and modules.builtin metadata for udev/kmod.
	# The parent pins this subpackage exactly; clear its inherited dependency.
	amove lib/modules
}

