Describe the DC-1 ALS on its existing AP-owned I2C bus.

Reuse the compatible from the public GPL MN29005 protocol driver:
https://github.com/OnePlusOSS/android_kernel_oneplus_mt6893/blob/48f1797695e24d46986a7c87dd91dd21cbf8c342/drivers/misc/mediatek/sensor/2.0/mn29005/mn29xxx.c
The native IIO driver checks revision 0x1288 before accepting this device.
Disable the unused SCP sensorhub node to keep AP sensor-bus ownership
exclusive. No pinmux, power, proximity or interrupt settings change.

--- a/arch/arm64/boot/dts/mediatek/mt8781-daylight-jagar.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8781-daylight-jagar.dts
@@ -1480,17 +1480,15 @@
 	pinctrl-0 = <&i2c1_pins>;
 	clock-frequency = <400000>;
 
-	/*
-	 * Memsic MN29-family ALS/proximity part, 7-bit address 0x49.
-	 *
-	 * Identified by the stock tinysys sensorhub driver name (`mn29xxx`) and
-	 * by live bit-banged probing (exactly one ACKing address), not yet by a
-	 * register ID.  The earlier pre-SCP probe saw every write-data byte NAK
-	 * and constant reads, so this node intentionally exposes the controller
-	 * for controlled measurement while leaving the device unbound.  Do not
-	 * add a compatible until both an exact part identity and its documented
-	 * register protocol are established.
-	 */
+	/*
+	 * AP owns GPIO132/133. Do not enable an SCP sensorhub on these pins.
+	 * Public MN29005 protocol, independently read revision 0x1288.
+	 * Polling ALS only; no proximity emitter or IRQ configuration.
+	 */
+	light-sensor@49 {
+		compatible = "mediatek,mn29xxxals";
+		reg = <0x49>;
+	};
 };
 
 &i2c6 {
@@ -2466,7 +2464,8 @@
  */
 &scp {
 	compatible = "mediatek,mt6789-tinysys-scp";
-	status = "okay";
+	/* Sensor buses belong to the AP; never start a competing sensorhub. */
+	status = "disabled";
 
 	reg = <0 0x10500000 0 0xc0000>,	/* sram / TCM */
 	      <0 0x10724000 0 0x1000>,	/* cfgreg */
