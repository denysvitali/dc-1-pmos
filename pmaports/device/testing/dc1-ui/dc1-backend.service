[Unit]
Description=DC-1 UI control plane
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
Before=gdm.service

[Service]
Type=simple
ExecStart=/usr/sbin/dc1-backend -socket /run/dc1-ui.sock
ExecStartPost=/usr/libexec/dc1-backend-socket-perms
Restart=on-failure

[Install]
WantedBy=multi-user.target
