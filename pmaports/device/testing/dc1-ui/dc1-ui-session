#!/bin/sh
# Launch the DC-1 Flutter shell as a Wayland client of the running Sway
# session. Sway execs this from /etc/sway/config.d/10-dc1-ui.conf.
#
# Everything device- and policy-specific lives here on purpose: the APKBUILD
# stays a plain install recipe and the sway drop-in stays a single exec line,
# so both remain upstreamable.
set -eu

# Flutter renders through the GTK3 embedder, which must talk Wayland rather
# than fall back to X11/Xwayland, and through Mesa's Panfrost gallium driver
# on the Mali-G57. llvmpipe is a failure mode, not a fallback: if the driver
# override cannot be honoured the app should fail visibly instead of
# painting slowly and silently in software.
export GDK_BACKEND=wayland
export MESA_LOADER_DRIVER_OVERRIDE=panfrost

# WLR_RENDERER is read by wlroots (the compositor), not by this client. It is
# exported here only so a session started by hand from this script's
# environment inherits the same renderer choice as the packaged one; the
# software-rendering escape hatch is cleared for the same reason.
export WLR_RENDERER=gles2
unset WLR_RENDERER_ALLOW_SOFTWARE || :

# The shell picks its own mode (first light vs onboarding) from the presence
# of the backend socket, but once the system has been provisioned there is
# nothing left to onboard, and re-running the flow would re-prompt for a
# username on every login. Pin it to first light in that case; the marker is
# the same one dc1-backend and installer/src/provision.sh gate on.
if [ -e /var/lib/dc1-installer/provisioned ]; then
	DC1_FIRST_LIGHT=1
	export DC1_FIRST_LIGHT
fi

# dc1-backend is ordered before the display manager (see dc1-backend.initd),
# but the shell reads the socket exactly once and never re-checks, so a
# backend that is merely slow or was just restarted still costs onboarding.
# Wait, bounded: five seconds, and only when onboarding is actually wanted,
# so a genuinely dead backend still reaches first light instead of hanging.
if [ -z "${DC1_FIRST_LIGHT:-}" ]; then
	n=0
	while [ ! -S "${DC1_BACKEND_SOCKET:-/run/dc1-ui.sock}" ] && [ "$n" -lt 50 ]; do
		n=$((n + 1))
		sleep 0.1
	done
fi

# The runner is named after the Flutter project (the Linux template sets
# BINARY_NAME to the project name), and it finds lib/ and data/ relative to
# itself -- so the bundle is installed and launched whole, from its own
# directory.
exec /usr/lib/dc1-ui/dc1_shell "$@"
