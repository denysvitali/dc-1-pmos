# Configuration for /etc/init.d/dc1-backend.

# Unix socket the control plane listens on. The Flutter shell looks here by
# default too (override there with DC1_BACKEND_SOCKET). Never a TCP address.
#socket="/run/dc1-ui.sock"

# UID of the desktop user the Sway session autologins as (pmOS default; see
# /etc/conf.d/tinydm AUTOLOGIN_UID). The socket is handed to this user's
# PRIMARY GROUP by gid, so it keeps working after onboarding renames the user
# and its group. Only change this if the autologin uid is changed elsewhere.
#ui_uid="10000"

# Optional override: a group NAME to hand the socket to instead of the desktop
# user's primary group. Leave unset to use the uid-derived primary group (the
# robust default); set it only if the shell runs as a non-autologin user.
#ui_group="dc1"
