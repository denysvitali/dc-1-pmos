pkgname=mutter-mobile
pkgver=999951.1.21
pkgrel=0
pkgdesc="clutter-based window manager and compositor"
url="https://gitlab.gnome.org/verdre/mutter-mobile"
# armhf: pmb#2618
arch="aarch64"
license="GPL-2.0-or-later"
depends="
	gnome-settings-daemon-mobile=$pkgver-r$pkgrel
	gsettings-desktop-schemas
	mutter-mobile-schemas=$pkgver-r$pkgrel
	mutter-mobile-udev=$pkgver-r$pkgrel
	xkeyboard-config
	"
makedepends="
	at-spi2-core-dev
	cairo-dev
	dbus-dev
	fribidi-dev
	gdk-pixbuf-dev
	glib-dev
	gnome-desktop-dev
	gnome-settings-daemon-mobile-dev=$pkgver-r$pkgrel
	gobject-introspection-dev
	graphene-dev
	gtk4.0-dev
	json-glib-dev
	lcms2-dev
	libadwaita-dev
	libcanberra-dev
	libdisplay-info-dev
	libdrm-dev
	libei-dev
	libglycin-dev
	libgudev-dev
	libice-dev
	libinput-dev
	libsm-dev
	libwacom-dev
	libx11-dev
	libxau-dev
	libxcb-dev
	libxcomposite-dev
	libxcursor-dev
	libxdamage-dev
	libxext-dev
	libxfixes-dev
	libxi-dev
	libxinerama-dev
	libxkbcommon-dev
	libxkbfile-dev
	libxrandr-dev
	libxrender-dev
	libxtst-dev
	mesa-dev
	meson
	pango-dev
	pipewire-dev
	py3-argcomplete
	py3-docutils
	startup-notification-dev
	wayland-dev
	wayland-protocols
	xkeyboard-config-dev
	xwayland-dev

	systemd-dev
	"
# TODO: crossdirect disabled due to armv7 crosscompile failure on x86_64, see
# https://gitlab.com/postmarketOS/pmaports/-/merge_requests/5115#note_1899890119
options="!check !pmb:crossdirect" # Can't be run with release builds
provides="mutter=$pkgver-r$pkgrel"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc $pkgname-lang $pkgname-schemas::noarch $pkgname-udev"
_commit="0aac77bdf278473d271813ad841555c06bc83e7b"
source="
	mutter-mobile-$_commit.tar.gz::https://gitlab.gnome.org/verdre/mutter-mobile/-/archive/$_commit/mutter-mobile-$_commit.tar.gz
	gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3.tar.gz::https://gitlab.gnome.org/GNOME/gvdb/-/archive/b54bc5da25127ef416858a3ad92e57159ff565b3/gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3.tar.gz
	mutter-mobile-orientation.patch
	"
builddir="$srcdir/mutter-mobile-$_commit"

prepare() {
	default_prepare
	sed -i 's/51\.1\.mobile\.21/51.1.21/g' meson.build
	mkdir -p subprojects/gvdb
	cp -R "$srcdir/gvdb-b54bc5da25127ef416858a3ad92e57159ff565b3"/. subprojects/gvdb/
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dintrospection=true \
		-Dremote_desktop=true \
		-Dprofiler=false \
		-Ddevkit=enabled \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		. output
	meson compile -C output
}

schemas() {
	provides="mutter-schemas=$pkgver-r$pkgrel"
	pkgdesc="Mutter schemas related files"
	depends=""

	amove usr/share/glib-2.0/schemas
	amove usr/share/GConf/gsettings
	amove usr/share/gnome-control-center/keybindings
}

dev() {
	provides="mutter-dev=$pkgver-r$pkgrel"
	default_dev
}

udev() {
	provides="mutter-udev=$pkgver-r$pkgrel"
	default_udev
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


