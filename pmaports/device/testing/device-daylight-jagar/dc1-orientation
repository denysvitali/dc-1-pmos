#!/usr/bin/python3
"""Apply MC3416 orientation changes to Mutter's built-in display."""

import os
import signal
import sys

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import Gio, GLib, GLibUnix


SENSOR_PATH = "/net/hadess/SensorProxy"
SENSOR_IFACE = "net.hadess.SensorProxy"
DISPLAY_PATH = "/org/gnome/Mutter/DisplayConfig"
DISPLAY_IFACE = "org.gnome.Mutter.DisplayConfig"
PROPERTIES_IFACE = "org.freedesktop.DBus.Properties"
SESSION_PATH = "/org/gnome/SessionManager"
SESSION_IFACE = "org.gnome.SessionManager"
ORIENTATION_SCHEMA = "org.gnome.settings-daemon.peripherals.touchscreen"

# Mutter's transforms are clockwise. The sensor names describe which edge is
# physically uppermost, so left-up means a clockwise quarter-turn of scanout.
TRANSFORMS = {
    "normal": 0,
    "left-up": 1,
    "bottom-up": 2,
    "right-up": 3,
}

# The panel scanout is 180 degrees from the glass, so glass-upright reads as
# bottom-up through the compensating accelerometer mount matrix. SensorProxy
# reports "undefined" until the accelerometer first settles (e.g. the device
# lying flat when a session starts); default to the glass-upright transform
# rather than leaving the raw, inverted scanout on screen.
DEFAULT_TRANSFORM = TRANSFORMS["bottom-up"]


class OrientationBridge:
    def __init__(self, system, session, settings, loop):
        self.system = system
        self.session = session
        self.settings = settings
        self.loop = loop
        self.sensor = None
        self.display = None
        self.session_manager = None
        self.source = 0
        self.retry = False
        self.stopping = False
        self.failing = False
        self.matches = []

    def start(self):
        # Subscribe before the initial read, so a startup change cannot be
        # lost between reading the state and installing the signal matches.
        self.matches.append(self.system.add_signal_receiver(
            self.sensor_changed, signal_name="PropertiesChanged",
            dbus_interface=PROPERTIES_IFACE, bus_name=SENSOR_IFACE,
            path=SENSOR_PATH, arg0=SENSOR_IFACE))
        self.matches.append(self.session.add_signal_receiver(
            self.queue, signal_name="MonitorsChanged",
            dbus_interface=DISPLAY_IFACE, bus_name=DISPLAY_IFACE,
            path=DISPLAY_PATH))
        for name, path in ((DISPLAY_IFACE, DISPLAY_PATH),
                           (SESSION_IFACE, SESSION_PATH)):
            self.matches.append(self.session.add_signal_receiver(
                self.visibility_changed, signal_name="PropertiesChanged",
                dbus_interface=PROPERTIES_IFACE, bus_name=name,
                path=path, arg0=name))
        for bus, name in ((self.system, SENSOR_IFACE),
                          (self.session, DISPLAY_IFACE),
                          (self.session, SESSION_IFACE)):
            self.matches.append(bus.add_signal_receiver(
                self.owner_changed, signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus",
                bus_name="org.freedesktop.DBus", path="/org/freedesktop/DBus",
                arg0=name))
        self.settings_id = self.settings.connect(
            "changed::orientation-lock", lambda *_args: self.queue())
        self.queue()

    def sensor_changed(self, interface, changed, invalidated):
        if interface == SENSOR_IFACE and any(
                key in changed or key in invalidated
                for key in ("AccelerometerOrientation", "HasAccelerometer")):
            self.queue()

    def owner_changed(self, name, _old, _new):
        # A ProxyObject refers to the old unique owner. Drop it on restart,
        # and reclaim the accelerometer when SensorProxy returns.
        if name == SENSOR_IFACE:
            self.sensor = None
        elif name == DISPLAY_IFACE:
            self.display = None
        elif name == SESSION_IFACE:
            self.session_manager = None
        self.queue()

    def visibility_changed(self, interface, changed, invalidated):
        key = {DISPLAY_IFACE: "PowerSaveMode",
               SESSION_IFACE: "SessionIsActive"}.get(interface)
        if key and (key in changed or key in invalidated):
            self.queue()

    def queue(self, delay=0):
        if self.stopping:
            return
        if self.source:
            if delay or not self.retry:
                return
            GLib.source_remove(self.source)
        self.retry = bool(delay)
        if delay:
            self.source = GLib.timeout_add(delay, self.refresh)
        else:
            self.source = GLib.idle_add(self.refresh)

    def refresh(self):
        self.source = 0
        self.retry = False
        try:
            if self.session_manager is None:
                self.session_manager = self.session.get_object(
                    SESSION_IFACE, SESSION_PATH)
            session_props = dbus.Interface(self.session_manager, PROPERTIES_IFACE)
            if not session_props.Get(SESSION_IFACE, "SessionIsActive"):
                return GLib.SOURCE_REMOVE
            if self.display is None:
                self.display = dbus.Interface(self.session.get_object(
                    DISPLAY_IFACE, DISPLAY_PATH), DISPLAY_IFACE)
            display_props = dbus.Interface(self.display, PROPERTIES_IFACE)
            # ApplyMonitorsConfig bypasses Mutter's native orientation guard.
            # Rebuilding views while blanked or in an inactive greeter retains
            # old scanout buffers until a modeset can finish, exhausting CMA.
            # Visibility signals above replay only the latest orientation.
            if int(display_props.Get(DISPLAY_IFACE, "PowerSaveMode")) != 0:
                return GLib.SOURCE_REMOVE
            if self.sensor is None:
                sensor = self.system.get_object(SENSOR_IFACE, SENSOR_PATH)
                sensor.ClaimAccelerometer(dbus_interface=SENSOR_IFACE)
                self.sensor = sensor
            # Stay subscribed while locked, but do not touch the transform.
            # Unlock schedules an immediate read of the latest sensor state.
            if self.settings.get_boolean("orientation-lock"):
                return GLib.SOURCE_REMOVE
            props = dbus.Interface(self.sensor, PROPERTIES_IFACE)
            orientation = str(props.Get(SENSOR_IFACE, "AccelerometerOrientation"))
            transform = TRANSFORMS.get(orientation, DEFAULT_TRANSFORM)
            serial, monitors, logical, _props = self.display.GetCurrentState()
            # Always compare with live state on an event: a restarted Mutter
            # or a manual monitor change can invalidate the previous apply.
            if any(int(entry[3]) != transform for entry in logical):
                mode_by_connector = {}
                for monitor_spec, modes, _monitor_props in monitors:
                    current_mode = str(modes[0][0])
                    for mode in modes:
                        if bool(mode[6].get("is-current", False)):
                            current_mode = str(mode[0])
                            break
                    mode_by_connector[str(monitor_spec[0])] = current_mode
                configured = []
                for x, y, scale, _old_transform, primary, outputs, _props in logical:
                    configured_outputs = [(str(output[0]),
                                           mode_by_connector[str(output[0])], {})
                                          for output in outputs]
                    configured.append((dbus.Int32(x), dbus.Int32(y),
                                       dbus.Double(scale), dbus.UInt32(transform),
                                       dbus.Boolean(primary), configured_outputs))
                self.display.ApplyMonitorsConfig(
                    dbus.UInt32(serial), dbus.UInt32(1), configured, {})
                print("dc1-orientation: %s -> transform %d" %
                      (orientation, transform), flush=True)
            self.failing = False
        except dbus.DBusException as error:
            if not self.failing:
                print("dc1-orientation: waiting for session peers: %s" % error,
                      file=sys.stderr, flush=True)
            self.failing = True
            # Only failures retry on a timer. Successful steady state has no
            # periodic work and makes no SensorProxy or Mutter method calls.
            self.display = None
            self.session_manager = None
            self.queue(1000)
        return GLib.SOURCE_REMOVE

    def stop(self):
        self.stopping = True
        if self.source:
            GLib.source_remove(self.source)
            self.source = 0
        for match in self.matches:
            match.remove()
        self.matches.clear()
        self.settings.disconnect(self.settings_id)
        if self.sensor is not None:
            try:
                self.sensor.ReleaseAccelerometer(dbus_interface=SENSOR_IFACE)
            except dbus.DBusException:
                pass
        self.loop.quit()
        return GLib.SOURCE_REMOVE


def main():
    session_address = os.environ.get("DBUS_SESSION_BUS_ADDRESS")
    if not session_address:
        print("dc1-orientation: no graphical session bus", file=sys.stderr)
        return 1
    DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    bridge = OrientationBridge(
        dbus.SystemBus(), dbus.bus.BusConnection(session_address),
        Gio.Settings.new(ORIENTATION_SCHEMA), loop)
    bridge.start()
    for signum in (signal.SIGTERM, signal.SIGINT):
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signum, bridge.stop)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
