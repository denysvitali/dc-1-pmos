#!/usr/bin/python3
"""Apply MC3416 orientation changes to Mutter's built-in display."""

import signal
import sys
import time

import dbus
from gi.repository import Gio


SENSOR_PATH = "/net/hadess/SensorProxy"
SENSOR_IFACE = "net.hadess.SensorProxy"
DISPLAY_PATH = "/org/gnome/Mutter/DisplayConfig"
DISPLAY_IFACE = "org.gnome.Mutter.DisplayConfig"
PROPERTIES_IFACE = "org.freedesktop.DBus.Properties"
ORIENTATION_SCHEMA = "org.gnome.settings-daemon.peripherals.touchscreen"

# Mutter's transforms are clockwise. The sensor names describe which edge is
# physically uppermost, so left-up means a clockwise quarter-turn of scanout.
TRANSFORMS = {
    "normal": 0,
    "left-up": 1,
    "bottom-up": 2,
    "right-up": 3,
}

# The panel scanout is 180 degrees from the glass, so glass-upright reads as
# bottom-up through the compensating accelerometer mount matrix. SensorProxy
# reports "undefined" until the accelerometer first settles (e.g. the device
# lying flat when a session starts); default to the glass-upright transform
# rather than leaving the raw, inverted scanout on screen.
DEFAULT_TRANSFORM = TRANSFORMS["bottom-up"]


def main():
    session_address = None
    for entry in ("DBUS_SESSION_BUS_ADDRESS",):
        session_address = __import__("os").environ.get(entry)
    if not session_address:
        print("dc1-orientation: no graphical session bus", file=sys.stderr)
        return 1

    running = True

    def stop(*_args):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    system = dbus.SystemBus()
    session = dbus.bus.BusConnection(session_address)

    def wait_for_object(bus, name, path, description):
        """Wait without failing the unit while a session peer starts."""
        reported = False
        while running:
            try:
                return bus.get_object(name, path)
            except dbus.DBusException:
                if not reported:
                    print("dc1-orientation: waiting for %s" % description,
                          flush=True)
                    reported = True
                time.sleep(0.25)
        return None

    # default.target can run before Mutter owns DisplayConfig, particularly
    # in the greeter. Waiting here keeps the service in a healthy activating
    # state instead of recording a failed start and relying on Restart=.
    sensor = wait_for_object(system, "net.hadess.SensorProxy", SENSOR_PATH,
                             "iio-sensor-proxy")
    display = wait_for_object(session, "org.gnome.Mutter.DisplayConfig",
                              DISPLAY_PATH, "Mutter")
    if sensor is None or display is None:
        return 0
    sensor_props = dbus.Interface(sensor, PROPERTIES_IFACE)
    display_api = dbus.Interface(display, DISPLAY_IFACE)
    orientation_settings = Gio.Settings.new(ORIENTATION_SCHEMA)

    while running:
        try:
            sensor.ClaimAccelerometer(dbus_interface=SENSOR_IFACE)
            break
        except dbus.DBusException as error:
            print("dc1-orientation: cannot claim accelerometer yet: %s" %
                  error, file=sys.stderr, flush=True)
            time.sleep(1)
    if not running:
        return 0

    # Compare against Mutter's live state instead of a cached last-applied
    # value: the compositor this bridge drives can be replaced under it (gdm
    # respawns the greeter shell), and the replacement comes up on the raw
    # scanout. A cache would then never reapply until the orientation changed.
    failing = False
    try:
        while running:
            # GNOME's quick-settings toggle writes orientation-lock.  This
            # bridge exists because Mutter's orientation manager does not
            # reliably claim the sensor on this device, so it must also honor
            # the setting that Mutter would normally enforce.  Leave the live
            # transform untouched while locked; on unlock the next tick
            # immediately applies the current sensor orientation.
            if orientation_settings.get_boolean("orientation-lock"):
                time.sleep(0.25)
                continue
            orientation = str(sensor_props.Get(SENSOR_IFACE,
                                                "AccelerometerOrientation"))
            transform = TRANSFORMS.get(orientation, DEFAULT_TRANSFORM)
            try:
                serial, monitors, logical, _props = \
                    display_api.GetCurrentState()
                if any(int(entry[3]) != transform for entry in logical):
                    mode_by_connector = {}
                    for monitor_spec, modes, _monitor_props in monitors:
                        connector = str(monitor_spec[0])
                        current_mode = str(modes[0][0])
                        for mode in modes:
                            if bool(mode[6].get("is-current", False)):
                                current_mode = str(mode[0])
                                break
                        mode_by_connector[connector] = current_mode
                    configured = []
                    for x, y, scale, _old_transform, primary, outputs, props \
                            in logical:
                        configured_outputs = []
                        for output in outputs:
                            # GetCurrentState returns monitor specs here;
                            # ApplyMonitorsConfig expects connector, current
                            # mode ID, and an a{sv} property dictionary.
                            connector = str(output[0])
                            configured_outputs.append((connector,
                                                       mode_by_connector[connector],
                                                       {}))
                        configured.append((dbus.Int32(x), dbus.Int32(y),
                                           dbus.Double(scale),
                                           dbus.UInt32(transform),
                                           dbus.Boolean(primary),
                                           configured_outputs))
                    display_api.ApplyMonitorsConfig(
                        dbus.UInt32(serial), dbus.UInt32(1), configured,
                        {})
                    print("dc1-orientation: %s -> transform %d" %
                          (orientation, transform), flush=True)
                failing = False
            except dbus.DBusException as error:
                # Print once per failure streak; the compositor being down
                # (session start, greeter respawn) fails every 0.25 s tick.
                if not failing:
                    print("dc1-orientation: Mutter update failed: %s" %
                          error, file=sys.stderr, flush=True)
                failing = True
                # A ProxyObject binds to the name owner that existed when it
                # was created. Reacquire it so a respawned greeter/session
                # shell receives orientation without restarting this unit.
                display = wait_for_object(
                    session, "org.gnome.Mutter.DisplayConfig", DISPLAY_PATH,
                    "Mutter")
                if display is None:
                    break
                display_api = dbus.Interface(display, DISPLAY_IFACE)
            time.sleep(0.25)
    finally:
        try:
            sensor.ReleaseAccelerometer(dbus_interface=SENSOR_IFACE)
        except dbus.DBusException:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
