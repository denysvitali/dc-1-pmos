#!/sbin/openrc-run
# dc1-audio -- give the device an ALSA card.
#
# The shipped LK device tree points the MT6789 AFE at the flat legacy SCPSYS
# node for its AUDIO power domain, and nothing provides that domain: the
# bootloader-handoff provider in the kernel publishes DISP alone, because AUDIO
# is genuinely off at handoff (SPM PWR_STATUS bit 22 reads 0) and has to be
# sequenced rather than inherited. So the AFE waits, times out at -110, and the
# machine card never gets its platform component -- no card, no PCM, no mixer.
#
# The sequence:
#
#   1. modprobe mt6789-live-audio-overlay -> applies
#      mediatek/mt8781-daylight-jagar-live-audio-probe.dtbo, which adds a
#      nested power controller carrying only MT6789_POWER_DOMAIN_AUDIO and
#      retargets the AFE at it. The domain is registered OFF; the AFE's runtime
#      PM powers it up.
#   2. echo 11210000.mt6789-afe-pcm > .../drivers_probe -> deferred re-probe,
#      the same poke dc1-gpu needs for the Mali node.
#
# Must run after localmount so /lib/firmware holds the overlay blob.

description="Bring up the MT6789 AFE and the MT6366 sound card"

depend() {
	need localmount
}

start() {
	ebegin "Bringing up audio"

	# On a mainline-DT boot (dtbswap) the tree wires the AFE itself and the
	# card is already up; only the stock tree needs the overlay + re-probe.
	if ! grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null; then
		modprobe mt6789-live-audio-overlay 2>/dev/null \
			|| { eend 1 "could not load the audio overlay module"; return 1; }

		printf '11210000.mt6789-afe-pcm\n' > /sys/bus/platform/drivers_probe 2>/dev/null \
			|| { eend 1 "drivers_probe write failed"; return 1; }
	fi

	# The machine card binds only once the AFE component registers, so wait
	# for the card itself: that is what userspace needs. Match it by name --
	# a card index says nothing about which card turned up.
	n=0
	while ! grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null && [ "$n" -lt 10 ]; do
		n=$((n + 1)); sleep 1
	done
	grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null \
		|| { eend 1 "the mt6789-mt6366 card did not appear"; return 1; }

	# Wire the speaker path. Without a UCM profile PipeWire leaves the DAPM
	# selectors at their reset values ("Open" for HPL/HPR Mux) and the RT9101
	# amp switch off, so nothing reaches the speakers. Set them once at startup;
	# they persist until the card is removed.
	#   DL1 PCM → ADDA_DL CH1/CH2 → HPL/HPR (LoudSPK Playback)
	#           → Ext_Speaker_Amp → RT9101 → speakers
	# Headphone is the master gain (+8 dB = 18). Lineout is +2 dB (12): the
	# speakers are asymmetric off the codec, one running through an extra
	# line-out (LOL) buffer gain stage the other does not, and +2 dB is the
	# by-ear trim that matches them (0 dB = quieter, +8 dB = louder + clips).
	local c="amixer -c mt6789mt6366 -q"
	if $c sset 'ADDA_DL_CH1 DL1_CH1' on \
	&& $c sset 'ADDA_DL_CH2 DL1_CH2' on \
	&& $c sset 'HPL Mux' 'LoudSPK Playback' \
	&& $c sset 'HPR Mux' 'LoudSPK Playback' \
	&& $c sset 'Ext_Speaker_Amp' on \
	&& $c sset 'Headphone' 18 \
	&& $c sset 'Lineout' 12 \
	&& $c sset 'ADDA_DL_GAIN' 100%; then
		# Persist the calibrated gains so every later mixer-state restore
		# converges on this working path instead of the stale mute zeros
		# the codec ramps to on stop (see dc1-audio for the full story).
		alsactl store mt6789mt6366 2>/dev/null \
			|| ewarn "could not persist the calibrated mixer state"
	else
		ewarn "speaker path amixer commands failed"
	fi

	eend 0
}
