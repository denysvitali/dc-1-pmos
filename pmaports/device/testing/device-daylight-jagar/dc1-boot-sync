#!/bin/sh
# dc1-boot-sync -- keep the flashed boot image in sync with the installed
# kernel apk, using the DC-1's A/B slots. Runs in two modes:
#
#   dc1-boot-sync            systemd oneshot, once per boot (network-online)
#   dc1-boot-sync --deploy   apk trigger, at `apk upgrade` time (no reboot)
#
# WHY COMPARE KERNEL IMAGES, NOT THE RELEASE STRING. The kernel apk installs
# /boot/vmlinuz, and the boot image on the active slot carries the SAME gzip'd
# kernel only if it was flashed at the same time. The obvious sync key --
# `uname -r` vs /usr/share/kernel/<flavor>/kernel.release -- is wrong for this
# device: both are "7.2.0-rc5" for a pkgrel-only bump (a kernel config or
# source-commit change keeps the same release string), so `apk upgrade` of the
# kernel would be invisible. The kernel IMAGE changes on every such bump, so
# this script extracts the gzip'd kernel from the active boot slot (Android v4
# header: kernel_size u32 at offset 8, kernel at offset 4096) and compares its
# SHA-256 against /boot/vmlinuz. That is the running-image proof.
#
# deploy() -- download the matching jagar-boot.img + SHA256SUMS from the
#   rolling release, verify SHA-256, write it to the INACTIVE slot (read back
#   and compare), then `dc1-slotctl arm` that slot for one try. The inactive
#   slot is never the one we are running from, so a failed switch falls back to
#   the still-proven slot. Does NOT reboot.
#
#   --deploy (the apk trigger) runs deploy() at upgrade time so the new slot is
#   armed BEFORE the reboot; the next normal reboot lands on the new kernel.
#
#   The boot-time oneshot is the backstop: if the trigger could not run (no
#   network at upgrade time, a manual kernel install, a first install that
#   never armed), it detects the mismatch, runs deploy(), and reboots. When the
#   kernel matches it marks the running slot proven (mark-successful) so a
#   LATER arm has a reliable fallback.
#
# Loop guard: one deploy attempt per installed kernel image. If the new kernel
# does not boot, the preloader decrements the try, marks the slot unbootable,
# and falls back to the proven slot; the marker stops a reboot loop.
#
# KNOWN LIMITATION: the rolling `latest` release can move between the apk
# upgrade and this download. If it does, the downloaded image is a valid but
# NEWER build; the device stays on the old slot until the next `apk upgrade`.
# No brick, no loop -- the failure mode is "the upgrade did not stick". A
# versioned release plus an on-device image/release cross-check would close
# this; not done yet.
set -eu

FLAVOR=postmarketos-mediatek-mt6789
VMLINUZ=/boot/vmlinuz
MARK=/var/lib/dc1/boot-sync-attempted
URL_BASE=${DC1_URL_BASE:-https://github.com/denysvitali/dc-1-pmos/releases/download/latest}
# boot_a/boot_b size window in 512-byte sectors (8 MiB .. 1 GiB), same as the
# installer's resolve_named_part uses: outside it the GPT mapping moved.
BOOT_MIN_SECTORS=16384
BOOT_MAX_SECTORS=2097152

# dtbo_a/dtbo_b size window in 512-byte sectors (8 MiB .. 64 MiB). Tighter than
# the boot window on purpose: the stub below is written to offset 0, so a moved
# mapping would destroy whatever partition it landed on.
DTBO_MIN_SECTORS=16384
DTBO_MAX_SECTORS=131072

log() { echo "dc1-boot-sync: $*" >&2; }

# resolve_boot a|b -> /dev/<node>. GPT-name resolution with a size window; a
# moved mapping must refuse rather than point dd at a boot-critical partition.
# DC1_SYSBLOCK overrides /sys/class/block for the offline tests.
resolve_boot() {
	name="boot_$1"
	sysblock=${DC1_SYSBLOCK:-/sys/class/block}
	found=""
	count=0
	for u in "$sysblock"/*/uevent; do
		[ -f "$u" ] || continue
		grep -q "^PARTNAME=$name\$" "$u" || continue
		count=$((count + 1))
		found=${u%/uevent}
		found=${found##*/}
	done
	[ "$count" -eq 1 ] || {
		log "expected exactly 1 PARTNAME=$name, found $count"
		return 1
	}
	sectors=$(cat "$sysblock/$found/size" 2>/dev/null || echo 0)
	case "$sectors" in ''|*[!0-9]*) sectors=0 ;; esac
	if [ "$sectors" -lt "$BOOT_MIN_SECTORS" ] || \
	   [ "$sectors" -gt "$BOOT_MAX_SECTORS" ]; then
		log "$name is $sectors sectors; refusing (mapping moved?)"
		return 1
	fi
	echo "/dev/$found"
}

# resolve_vendor_boot a|b -> /dev/<node>. Same size window as boot_a/b;
# the vendor_boot partitions are the same 64 MiB as the boot slots and carry
# the DTB that LK actually passes to the kernel.
resolve_vendor_boot() {
	name="vendor_boot_$1"
	sysblock=${DC1_SYSBLOCK:-/sys/class/block}
	found=""
	count=0
	for u in "$sysblock"/*/uevent; do
		[ -f "$u" ] || continue
		grep -q "^PARTNAME=$name\$" "$u" || continue
		count=$((count + 1))
		found=${u%/uevent}
		found=${found##*/}
	done
	[ "$count" -eq 1 ] || {
		log "expected exactly 1 PARTNAME=$name, found $count"
		return 1
	}
	sectors=$(cat "$sysblock/$found/size" 2>/dev/null || echo 0)
	case "$sectors" in ''|*[!0-9]*) sectors=0 ;; esac
	if [ "$sectors" -lt "$BOOT_MIN_SECTORS" ] || \
	   [ "$sectors" -gt "$BOOT_MAX_SECTORS" ]; then
		log "$name is $sectors sectors; refusing (mapping moved?)"
		return 1
	fi
	echo "/dev/$found"
}

# resolve_dtbo a|b -> /dev/<node>. Same fail-closed shape as resolve_boot, on
# the dtbo window.
resolve_dtbo() {
	name="dtbo_$1"
	sysblock=${DC1_SYSBLOCK:-/sys/class/block}
	found=""
	count=0
	for u in "$sysblock"/*/uevent; do
		[ -f "$u" ] || continue
		grep -q "^PARTNAME=$name\$" "$u" || continue
		count=$((count + 1))
		found=${u%/uevent}
		found=${found##*/}
	done
	[ "$count" -eq 1 ] || {
		log "expected exactly 1 PARTNAME=$name, found $count"
		return 1
	}
	sectors=$(cat "$sysblock/$found/size" 2>/dev/null || echo 0)
	case "$sectors" in ''|*[!0-9]*) sectors=0 ;; esac
	if [ "$sectors" -lt "$DTBO_MIN_SECTORS" ] || \
	   [ "$sectors" -gt "$DTBO_MAX_SECTORS" ]; then
		log "$name is $sectors sectors; refusing (mapping moved?)"
		return 1
	fi
	echo "/dev/$found"
}

# dtbo_stub -- a 136-byte dt_table holding one overlay that does nothing.
#
# LK merges dtbo_<slot> onto the DTB it takes from vendor_boot_<slot>. The
# stock overlay is written against the stock tree: its __fixups__ bind symbols
# (`pio`, `mt6358_vrf18_reg`, ...) that our mainline DTB does not export at all,
# because kernel dtbs are not built with `-@` and so carry no __symbols__ node.
# Merged onto the mainline base anyway, it grafts stock nodes into mainline
# ones -- observed on hardware as a mainline `pinctrl@10005000` holding stock
# pin state and `panel1@0` under `dsi@14013000`, i.e. pinctrl failing to probe
# with "invalid resource (null)", no display, no UDC, and LK falling back.
#
# One entry, not zero. An empty table reads like the obvious "nothing to
# merge", but it is an error path in this LK; the strings in lk_a are:
#
#   Set dtbo_entry_idx to 0: dtbo_entry_idx %d >= num_of_dtbo %d.
#   load_dtbo fail, fdt size(%d)
#   ufdt_apply_overlay() failed!
#   DT overlay fail (%d)
#
# num_of_dtbo = 0 clamps the index to 0 and LK then loads entry 0 of a table
# with no entries. A zero-entry stub was tried on hardware and did not boot.
#
# So the entry points at a valid FDT with an empty root and no fragments: LK
# finds a well-formed overlay, applies it, and nothing changes. Bytes are
# dt_table_header (magic, total_size 136, header_size 32, dt_entry_size 32,
# dt_entry_count 1, dt_entries_offset 32, page_size 2048, version 0), one
# dt_table_entry (size 72, offset 64), then the 72-byte overlay -- which is
# `/dts-v1/; /plugin/; / { };` as built by dtc.
dtbo_stub() {
	printf '\327\267\253\036\000\000\000\210\000\000\000\040\000\000\000\040\000\000\000\001\000\000\000\040\000\000\010\000\000\000\000\000\000\000\000\110\000\000\000\100\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\320\015\376\355\000\000\000\110\000\000\000\070\000\000\000\110\000\000\000\050\000\000\000\021\000\000\000\020\000\000\000\000\000\000\000\000\000\000\000\020\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000\001\000\000\000\000\000\000\000\002\000\000\000\011'
}

# neutralize_dtbo a|b -- replace that slot's overlay with an empty dt_table.
# Refuses unless the target already looks like a dt_table, so a resolver that
# somehow returned the wrong node cannot be written to. Idempotent: a stub is
# itself a valid dt_table.
neutralize_dtbo() {
	dtbo_dev=$(resolve_dtbo "$1") || return 1
	magic=$(od -An -tx1 -N4 "$dtbo_dev" 2>/dev/null | tr -d ' \n')
	[ "$magic" = "d7b7ab1e" ] || {
		log "$dtbo_dev does not start with a dt_table magic (got '${magic:-nothing}'); refusing"
		return 1
	}
	# Stub plus enough zeroes to wipe the old table behind it.
	{ dtbo_stub; dd if=/dev/zero bs=3960 count=1 2>/dev/null; } \
		| dd of="$dtbo_dev" bs=4096 count=1 conv=fsync 2>/dev/null \
		|| { log "dtbo stub write failed"; return 1; }
	sync
	readback=$(od -An -tx1 -N136 "$dtbo_dev" 2>/dev/null | tr -d ' \n')
	want=$(dtbo_stub | od -An -tx1 -N136 | tr -d ' \n')
	[ "$readback" = "$want" ] || { log "dtbo stub read-back mismatch"; return 1; }
	log "dtbo neutralized on $dtbo_dev (one no-op overlay; LK merges nothing)"
}

# active_slot -> a|b, from dc1-slotctl's own priority-based get_suffix decode.
active_slot() {
	dc1-slotctl status | sed -n 's/.*active=\([ab]\).*/\1/p'
}

# kernel_sha DEV -> SHA-256 of the gzip'd kernel inside an Android v4 boot
# image. Header is 1584 bytes padded to 4096, so the kernel starts at 4096;
# kernel_size is the little-endian u32 at offset 8 (the same layout
# boot/repack-boot.sh writes). Returns 1 on a bogus size.
kernel_sha() {
	dev=$1
	ksize=$(od -An -tu4 -N4 -j8 "$dev" | tr -d ' ')
	case "$ksize" in ''|*[!0-9]*|0) log "cannot read kernel size from $dev"; return 1 ;; esac
	# A kernel is a few MiB; anything near the 64 MiB partition is a misread.
	[ "$ksize" -gt 67108864 ] && { log "kernel size $ksize is implausible"; return 1; }
	dd if="$dev" bs=4096 skip=1 2>/dev/null | head -c "$ksize" | sha256sum | cut -d' ' -f1
}

# deploy INSTALLED_SHA -- download, verify, flash the INACTIVE slot, arm it.
# Sets the loop-guard marker. Returns 0 on success. Does NOT reboot.
#
# Both jagar-boot.img (kernel + initramfs) and jagar-vendor-boot.img (our
# mainline DTB) are downloaded and verified BEFORE any partition is touched,
# so a failed download never leaves a slot with a mismatched kernel/DT pair.
deploy() {
	installed=$1
	log "deploying boot image (kernel sha256 $installed) to the inactive slot"
	mkdir -p /var/lib/dc1
	work=$(mktemp -d)
	trap 'rm -rf "$work"' EXIT
	cd "$work"

	# Download and verify the matching boot image. curl -f fails on HTTP
	# errors; -L follows GitHub's S3 redirect for the asset.
	log "downloading SHA256SUMS"
	curl -fsSL --retry 3 --retry-delay 3 -o SHA256SUMS "$URL_BASE/SHA256SUMS" \
		|| { log "cannot fetch SHA256SUMS (no network?)"; return 1; }
	want=$(awk -v n=jagar-boot.img '{ f=$2; sub(/^\*/,"",f); if (f==n) print $1 }' SHA256SUMS)
	[ -n "$want" ] || { log "no jagar-boot.img entry in SHA256SUMS"; return 1; }
	log "downloading jagar-boot.img"
	curl -fsSL --retry 3 --retry-delay 3 -o jagar-boot.img "$URL_BASE/jagar-boot.img" \
		|| { log "cannot fetch jagar-boot.img"; return 1; }
	got=$(sha256sum jagar-boot.img | cut -d' ' -f1)
	[ "$got" = "$want" ] || { log "jagar-boot.img sha256 mismatch"; return 1; }

	# Our mainline DTB, and it is NOT deployed by default -- see below.
	#
	# LK reads the DTB from vendor_boot, not boot.img, so shipping our own
	# tree means writing vendor_boot. That was switched on unconditionally
	# while the board DTS still had no panel node and set
	# `&dsi0 { status = "disabled"; }` -- i.e. it was deploying a device tree
	# that gives no display at all, confirmed 2026-08-17 by decompiling the
	# very image this function had just written and armed.
	#
	# The DTS describes the panel now (kernel a3a633ef9), so the tree is
	# expected to light the screen. Expected, not observed: no boot on the
	# mainline DTB has happened yet, and getting it wrong costs the display
	# with only fastboot to recover through. Keep it opt-in until one does.
	# Set DC1_DEPLOY_VENDOR_BOOT=1 to take it -- that is what reaches the
	# accelerometer and LVTS thermal, which the stock tree cannot express --
	# and keep a serial console or SSH open when you do.
	if [ "${DC1_DEPLOY_VENDOR_BOOT:-0}" = 1 ]; then
		want_vb=$(awk -v n=jagar-vendor-boot.img '{ f=$2; sub(/^\*/,"",f); if (f==n) print $1 }' SHA256SUMS)
		[ -n "$want_vb" ] || { log "no jagar-vendor-boot.img entry in SHA256SUMS"; return 1; }
		log "downloading jagar-vendor-boot.img (DC1_DEPLOY_VENDOR_BOOT=1)"
		curl -fsSL --retry 3 --retry-delay 3 -o jagar-vendor-boot.img \
			"$URL_BASE/jagar-vendor-boot.img" \
			|| { log "cannot fetch jagar-vendor-boot.img"; return 1; }
		got_vb=$(sha256sum jagar-vendor-boot.img | cut -d' ' -f1)
		[ "$got_vb" = "$want_vb" ] || { log "jagar-vendor-boot.img sha256 mismatch"; return 1; }
	else
		log "not deploying vendor_boot (mainline DTB unproven on hardware);"
		log "  set DC1_DEPLOY_VENDOR_BOOT=1 to override -- that also replaces"
		log "  the same slot's stock dtbo with an empty one, which it must"
	fi

	active=$(active_slot) || { log "cannot determine the active slot"; return 1; }
	[ -z "$active" ] && { log "cannot determine the active slot"; return 1; }
	inactive=$([ "$active" = a ] && echo b || echo a)
	boot_dev=$(resolve_boot "$inactive") || return 1
	vendor_boot_dev=$(resolve_vendor_boot "$inactive") || return 1

	sysblock=${DC1_SYSBLOCK:-/sys/class/block}

	img_bytes=$(wc -c < jagar-boot.img | tr -d ' ')
	bsectors=$(cat "$sysblock/${boot_dev##*/}/size" 2>/dev/null || echo 0)
	case "$bsectors" in ''|*[!0-9]*) bsectors=0 ;; esac
	if [ "$img_bytes" -gt $((bsectors * 512)) ]; then
		log "jagar-boot.img ($img_bytes bytes) larger than $boot_dev"
		return 1
	fi

	if [ -f jagar-vendor-boot.img ]; then
		vb_bytes=$(wc -c < jagar-vendor-boot.img | tr -d ' ')
		vb_sectors=$(cat "$sysblock/${vendor_boot_dev##*/}/size" 2>/dev/null || echo 0)
		case "$vb_sectors" in ''|*[!0-9]*) vb_sectors=0 ;; esac
		if [ "$vb_bytes" -gt $((vb_sectors * 512)) ]; then
			log "jagar-vendor-boot.img ($vb_bytes bytes) larger than $vendor_boot_dev"
			return 1
		fi
	fi

	log "writing jagar-boot.img ($img_bytes bytes) to $boot_dev (inactive slot $inactive)"
	dd if=jagar-boot.img of="$boot_dev" bs=1M conv=fsync 2>/dev/null \
		|| { log "boot image write failed"; return 1; }
	sync
	readback=$(head -c "$img_bytes" "$boot_dev" | sha256sum | cut -d' ' -f1)
	[ "$readback" = "$got" ] || { log "boot image read-back mismatch"; return 1; }
	log "boot image verified on $boot_dev"

	if [ -f jagar-vendor-boot.img ]; then
		log "writing jagar-vendor-boot.img ($vb_bytes bytes) to $vendor_boot_dev (inactive slot $inactive)"
		dd if=jagar-vendor-boot.img of="$vendor_boot_dev" bs=1M conv=fsync 2>/dev/null \
			|| { log "vendor_boot image write failed"; return 1; }
		sync
		readback_vb=$(head -c "$vb_bytes" "$vendor_boot_dev" | sha256sum | cut -d' ' -f1)
		[ "$readback_vb" = "$got_vb" ] || { log "vendor_boot image read-back mismatch"; return 1; }
		log "vendor_boot image verified on $vendor_boot_dev"

		# The mainline DTB and this slot's stock overlay cannot coexist: LK
		# merges the overlay onto whatever vendor_boot carries, and the stock
		# one mangles a mainline base (see dtbo_stub). Neutralize it on the
		# SAME slot we just wrote, and only that slot -- the other keeps its
		# stock vendor_boot/dtbo pair as the fallback.
		neutralize_dtbo "$inactive" || {
			log "could not neutralize dtbo_$inactive; refusing to arm a slot"
			log "  whose mainline DTB would be merged with the stock overlay"
			return 1
		}
	fi

	# Arm the inactive slot for one try: priority 15/tries 1/successful 0, the
	# other (proven) slot dropped to 14. On a failed boot the preloader
	# decrements the try, marks it unbootable, and falls back.
	dc1-slotctl arm "$inactive" --tries 1 || { log "arming $inactive failed"; return 1; }

	# Record the attempt so a fallback does not loop.
	echo "$installed" > "$MARK"
	sync
	log "deployed to slot $inactive and armed"
	return 0
}

# Library mode for the offline tests: source this file to get resolve_boot,
# resolve_vendor_boot, resolve_dtbo, dtbo_stub, and active_slot without running
# the sync.
if [ -n "${DC1_BOOT_SYNC_LIB:-}" ]; then
	return 0 2>/dev/null || exit 0
fi

[ -f "$VMLINUZ" ] || { log "no $VMLINUZ; nothing to sync"; exit 0; }
installed_sha=$(sha256sum "$VMLINUZ" | cut -d' ' -f1)

# --deploy (the apk trigger): deploy + arm now, no reboot. FULLY BEST-EFFORT:
# the trigger also fires inside the build chroot (the kernel package install
# touches /boot/vmlinuz), where there is no device and no boot partition. Any
# failure -- no active slot, no boot partition, a failed download -- must exit
# 0 so it never fails the apk transaction; the boot-time path below is the
# backstop that retries on next boot.
if [ "${1:-}" = "--deploy" ]; then
	active=$(active_slot 2>/dev/null) || active=""
	[ -n "$active" ] || { log "no active slot (chroot?); deferring to boot"; exit 0; }
	boot_dev=$(resolve_boot "$active" 2>/dev/null) || { log "no boot partition; deferring to boot"; exit 0; }
	booted_sha=$(kernel_sha "$boot_dev" 2>/dev/null) || { log "cannot read booted kernel; deferring to boot"; exit 0; }
	if [ "$booted_sha" = "$installed_sha" ]; then
		log "already running the installed kernel; nothing to deploy"
		exit 0
	fi
	deploy "$installed_sha" || { log "deploy failed; will retry at boot"; exit 0; }
	exit 0
fi

# Boot-time (oneshot) path. On a real device these must succeed: a slot we
# cannot resolve here is a failure worth surfacing, not a silent skip.
active=$(active_slot) || { log "cannot determine the active slot"; exit 1; }
[ -z "$active" ] && { log "cannot determine the active slot"; exit 1; }
boot_dev=$(resolve_boot "$active") || exit 1
booted_sha=$(kernel_sha "$boot_dev") || exit 1

if [ "$booted_sha" = "$installed_sha" ]; then
	# In sync: nothing to flash. Ensure the running slot is proven so a LATER
	# arm of the other slot has a reliable fallback. Best-effort: misc may be
	# unreadable on a device whose A/B block was never set up.
	dc1-slotctl mark-successful "$active" 2>/dev/null || true
	rm -f "$MARK"
	exit 0
fi

# Out of sync. One attempt per installed kernel image, so a kernel that cannot
# boot does not become a reboot loop.
if [ "$(cat "$MARK" 2>/dev/null)" = "$installed_sha" ]; then
	log "already tried to switch to $installed_sha; it did not stick"
	log "staying on the current kernel -- re-run 'apk upgrade' after fixing it"
	exit 1
fi

log "installed kernel $installed_sha differs from booted $booted_sha; syncing"
deploy "$installed_sha" || exit 1
log "armed the new kernel; rebooting into it"
reboot
