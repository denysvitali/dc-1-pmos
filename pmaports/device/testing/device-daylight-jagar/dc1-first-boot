#!/bin/sh
# First-boot desktop app install: pull the DC-1 app set from Alpine over the
# network the installer already configured. Runs as a systemd oneshot after the
# signing keys are linked and the network is up.
#
# The bare rootfs ships without the heavy desktop apps (Chromium, terminals,
# etc.) so the image stays small; this fetches them from Alpine on the device
# where the grown root and the network actually exist. Idempotent-by-marker,
# and the marker is written only after a SUCCESSFUL install, so a no-network
# boot retries on the next one instead of silently skipping the apps.
MARK=/var/lib/dc1/first-boot-apps-done
# The curated set. Keep it small and editable: this is a list of apk package
# names, not a manifest file.
APPS="chromium ghostty gnome-console gnome-calculator gnome-text-editor nautilus"

[ -e "$MARK" ] && exit 0

mkdir -p /var/lib/dc1
# network-online.target means an address is assigned, NOT that DNS resolves
# (the first install died here on "DNS: transient error" the instant the
# service ran). apk add is idempotent, so retry the whole thing with a backoff
# and let the marker (written only on success) catch a still-cold network on
# the next boot.
for attempt in 1 2 3 4 5 6 7 8; do
	if apk update >/dev/null 2>&1 && apk add $APPS; then
		touch "$MARK"
		exit 0
	fi
	sleep 15
done
exit 1
