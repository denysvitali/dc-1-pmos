[Unit]
Description=DC-1 accelerometer display orientation
After=graphical-session.target
# The bridge exits until Mutter's bus name resolves, which can take longer
# than the default 5-starts-in-10s limit allows at session startup (and in
# the gdm greeter graphical-session.target never activates, so After= gives
# no ordering there). Restarting until the compositor appears is the design.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/libexec/dc1-orientation
Restart=always
RestartSec=1
# Exit 3 = the session's compositor (KWin under Plasma Mobile) rotates on
# its own; see foreign_desktop() in dc1-orientation.
RestartPreventExitStatus=3
SuccessExitStatus=3

[Install]
WantedBy=default.target
