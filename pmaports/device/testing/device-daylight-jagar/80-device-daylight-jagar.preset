# Enable the DC-1 device services under systemd. The OpenRC equivalents are
# registered by the package's post-install (rc-update), which no-ops when
# systemd is in use.
enable dc1-usb-gadget.service
enable dc1-debug-shell.service
enable dc1-display-gate.service
enable dc1-gpu.service
enable dc1-audio.service
enable dc1-bluetooth.service
enable dc1-frontlight.service
enable dc1-screen-backlight.service
enable dc1-rtcsync.timer
enable dc1-link-apk-keys.service
enable dc1-first-boot.service
enable dc1-boot-sync.service
enable dc1-update.timer
# The clean-poweroff flag unit backs charging mode (dc1-charging-generator
# reads the flag it records). basic.target, not multi-user: charging mode
# requires basic but never reaches multi-user, so recording must ride on
# basic to also cover unplug-poweroffs from charge sessions.
enable dc1-poweroff-flag.service
