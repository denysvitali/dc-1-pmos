#!/bin/sh
# Re-assert the boot services after an upgrade (the runlevel entries survive,
# but re-register in case a service was dropped or renamed between versions).
# An upgraded device never ran post-install, so without this the keys are
# linked on fresh installs only and apk upgrade stays broken forever.
[ -x /usr/libexec/dc1-link-apk-keys ] && /usr/libexec/dc1-link-apk-keys

# Keep this list identical to the one in the post-install hook, runlevels and
# all. It drifted: dc1-audio, dc1-usb-gadget and dc1-debug-shell were added to
# post-install after this file was written and never added here, so an OpenRC
# device installed before those commits and upgraded since has no sound card,
# no USB ethernet, and no debug shells (which `need dc1-usb-gadget`) in any
# runlevel. Every line is `2>/dev/null || true`, so the omission is completely
# silent -- the same failure shape dc1-link-apk-keys above was extracted to
# avoid.
rc-update add dc1-display-gate boot 2>/dev/null || true
rc-update add dc1-gpu boot 2>/dev/null || true
rc-update add dc1-usb-gadget boot 2>/dev/null || true
rc-update add dc1-audio default 2>/dev/null || true
rc-update add dc1-bluetooth default 2>/dev/null || true
rc-update add dc1-frontlight default 2>/dev/null || true
rc-update add dc1-screen-backlight default 2>/dev/null || true
rc-update add dc1-rtcsync default 2>/dev/null || true
rc-update add dc1-debug-shell default 2>/dev/null || true
if [ -x /etc/init.d/sshd ]; then
	rc-update add sshd default 2>/dev/null || true
fi

glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true

# dc1-audio moved from multi-user.target to sound.target (pkgrel 59) so its
# After=alsa-restore.service finally holds: both units are wanted by
# sound.target, which udev pulls when the card registers -- often after
# multi-user already started the old symlink, which is exactly how the
# restore-of-mute landed on top of the calibrated gains. reenable recreates
# the enablement symlink from the new [Install]; an upgraded device would
# otherwise keep starting the unit from the stale multi-user link, outside
# the sound.target transaction, and the race would survive the upgrade.
systemctl reenable dc1-audio.service 2>/dev/null || true

# The update timer arrives with pkgrel 61; presets are never re-run on an
# upgrade, so without this it stays DISABLED on exactly the frozen devices
# that need it most. Enable only -- no start mid-transaction; the first run
# happens OnBootSec after the next boot.
systemctl reenable dc1-update.timer 2>/dev/null || true

# The clean-poweroff flag unit arrives with pkgrel 79; presets are never
# re-run on an upgrade, so without this an upgraded device would never
# start it and charging mode would never see a recorded flag. Same shape
# as the update timer above: enable only, no start mid-transaction.
systemctl reenable dc1-poweroff-flag.service 2>/dev/null || true

# The fallback-gauge continuity hook arrives with pkgrel 88. Presets are not
# rerun on upgrade; enable it for existing installations, without starting it
# in the middle of an apk transaction.
systemctl reenable dc1-battery-state.service 2>/dev/null || true

# Keep in step with post-install: rebuild the udev hwdb for the side-button
# remap and re-trigger the input devices. Best-effort, as above.
systemd-hwdb update 2>/dev/null || true
udevadm trigger /dev/input/event* 2>/dev/null || true
# WirePlumber 0.5.15 alsa.lua concatenates a nil node.name when an
# ALSA adapter bind fails, which takes the monitor down and leaves
# GNOME on Dummy Output. Re-apply the tostring() guard; a missing
# script (build chroot, or a future wireplumber layout) is a no-op.
[ -x /usr/libexec/dc1-fix-wireplumber-alsa ] &&
	/usr/libexec/dc1-fix-wireplumber-alsa || true
exit 0
