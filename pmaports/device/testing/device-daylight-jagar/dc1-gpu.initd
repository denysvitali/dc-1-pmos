#!/sbin/openrc-run
# dc1-gpu -- bring the Mali-G57 up so the compositor gets a Panfrost render node.
#
# The GPU is held behind a runtime OF overlay (not a cold-DT entry) because
# probing it at boot would walk the MFG power domains before they are safe.
# The sequence, proven on hardware:
#
#   1. modprobe mt6789-live-gpu-overlay   -> requests the pinned overlay
#      firmware (mediatek/mt8781-daylight-jagar-live-gpu-probe.dtbo), applies
#      it, and holds vgpu/vsram_gpu at 850 mV.
#   2. modprobe panfrost                  -> makes the Mali-G57 driver ready.
#   3. echo 13000000.mali > .../drivers_probe -> deferred re-probe. The overlay
#      flips the mali node to status=okay; without this poke panfrost sits
#      loaded but never binds, and there is no /dev/dri/renderD128.
#
# Run before tinydm so Sway starts with the render node present (hardware GLES)
# instead of falling back to software. Must run after localmount/devfs so
# /lib/firmware and the platform bus are available.
#
# The "Failed to register cooling device" panfrost message is expected and
# non-fatal: this board has no GPU cooling device / calibrated LVTS.

description="Bring up the Mali-G57 (Panfrost) GPU"

depend() {
	need localmount
	before tinydm
}

start() {
	ebegin "Bringing up the Mali-G57 GPU"

	# The braces are load-bearing: `a || b; return 1` parses as
	# `(a || b); return 1`, so the return fires whether or not modprobe
	# succeeded. Measured on hardware 2026-08-15: this service had never once
	# started -- it reported "failed to start" immediately after a modprobe
	# that worked, so panfrost never bound, there was no renderD128, and the
	# Flutter shell fell back to llvmpipe on a device with a perfectly good
	# Mali-G57. The drivers_probe check below always had its braces, which is
	# why only these two lines were wrong.
	modprobe mt6789-live-gpu-overlay 2>/dev/null \
		|| { eend 1 "could not load the GPU overlay module"; return 1; }
	modprobe panfrost 2>/dev/null \
		|| { eend 1 "could not load panfrost"; return 1; }

	# Re-probe the mali platform device so panfrost binds it. The overlay
	# changes its status from disabled to okay; the deferred probe has
	# already given up, so it must be poked to retry -- the same pattern as
	# the panel gate.
	printf '13000000.mali\n' > /sys/bus/platform/drivers_probe 2>/dev/null \
		|| { eend 1 "drivers_probe write failed"; return 1; }

	# Wait for the render node so downstream (tinydm -> sway) is ordered after
	# the GPU is actually usable.
	n=0
	while [ ! -e /dev/dri/renderD128 ] && [ "$n" -lt 15 ]; do
		n=$((n + 1)); sleep 1
	done
	[ -e /dev/dri/renderD128 ] \
		|| { eend 1 "renderD128 did not appear"; return 1; }

	eend 0
}
