#!/sbin/openrc-run
# dc1-usb-gadget -- bring up the DC-1 USB gadget (CDC-ECM ethernet + 2x CDC-ACM)
# so a host over USB can reach the installed system: SSH and the TCP 4444 shell
# over usb0, plus the kmsg stream (ttyGS0) and an interactive shell (ttyGS1).
#
# The gadget stack is built into the kernel (=y), so this is pure configfs --
# no modules to load. The VID/PID and MACs match the installer initramfs
# (installer/src/init.c gadget()), so the host's cdc_ether setup (host MAC
# 02:1a:11:00:00:01, host 172.16.42.2/24) works unchanged.
description="Bring up the DC-1 USB gadget (ECM ethernet + 2x ACM)"

depend() {
	need localmount
	after sysfs
}

G=/sys/kernel/config/usb_gadget/g1
DEV_IP=172.16.42.1

write() {
	printf '%s\n' "$2" >"$1" 2>/dev/null
}

# Make sure the config we are about to bind actually carries the ECM function.
# The handed-off gadget is not always the one the installer built: a plain
# (non-installer) boot can hand over an ACM-only gadget, and on hardware
# 2026-08-17 it did -- g1 held acm.0 and acm.1 and no ecm.0 at all, so the
# rebind produced /dev/ttyGS0 and /dev/ttyGS1 but never a usb0, taking USB
# ethernet and SSH-over-USB with it. Adding the missing function here is safe:
# the UDC is unbound, which is exactly the state the build path below works in.
# Removing anything is not safe (see teardown), so this only ever adds.
ensure_ecm() {
	cfg=$(find "$G"/configs -maxdepth 1 -mindepth 1 -type d 2>/dev/null \
		| head -1)
	[ -n "$cfg" ] || return 1
	[ -e "$cfg/ecm.0" ] && return 0

	mkdir -p "$G/functions/ecm.0" || return 1
	write "$G/functions/ecm.0/dev_addr" 02:1a:11:00:00:02
	write "$G/functions/ecm.0/host_addr" 02:1a:11:00:00:01
	ln -sf "$G/functions/ecm.0" "$cfg/ecm.0"
}

start() {
	ebegin "Bringing up the DC-1 USB gadget"

	# The system initramfs mounts proc/sysfs/devtmpfs but NOT configfs, and
	# the rootfs' OpenRC sysfs service is not in a runlevel, so configfs is
	# otherwise never mounted here. Mount it before the gadget setup.
	if ! grep -qs ' /sys/kernel/config configfs ' /proc/mounts; then
		mkdir -p /sys/kernel/config
		mount -t configfs configfs /sys/kernel/config 2>/dev/null \
			|| { eend 1 "configfs mount failed"; return 1; }
	fi

	UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
	[ -n "$UDC" ] || { eend 1 "no UDC (MUSB not registered?)"; return 1; }

	# An existing tree is always reused, never rebuilt -- removing gadget
	# objects is what wedges this device (see unbind()). The initramfs leaves
	# one behind: it builds a gadget, binds the UDC, then unbinds it before
	# switch_root but leaves the configfs tree intact. Unbind whatever is bound
	# (safe, reversible), complete the tree in place, then bind.
	if [ -d "$G" ]; then
		unbind
		ensure_ecm \
			|| { eend 1 "could not add ecm.0 to the existing gadget"; \
				return 1; }
	else
		mkdir -p "$G" || { eend 1 "configfs usb_gadget unavailable"; return 1; }
		write "$G/idVendor" 0x18d1
		write "$G/idProduct" 0x4ee7
		mkdir -p "$G/strings/0x409"
		write "$G/strings/0x409/manufacturer" daylight
		write "$G/strings/0x409/product" dc1-pmos
		write "$G/strings/0x409/serialnumber" dc1-pmos

		mkdir -p "$G/configs/c.1/strings/0x409"
		write "$G/configs/c.1/strings/0x409/configuration" "acm+ecm"
		mkdir -p "$G/functions/acm.0" "$G/functions/acm.1" "$G/functions/ecm.0"
		write "$G/functions/ecm.0/dev_addr" 02:1a:11:00:00:02
		write "$G/functions/ecm.0/host_addr" 02:1a:11:00:00:01
		ln -sf "$G/functions/acm.0" "$G/configs/c.1/acm.0"
		ln -sf "$G/functions/acm.1" "$G/configs/c.1/acm.1"
		ln -sf "$G/functions/ecm.0" "$G/configs/c.1/ecm.0"
	fi

	echo "$UDC" >"$G/UDC" 2>/dev/null \
		|| { eend 1 "UDC bind failed"; return 1; }

	# usb0 appears on the UDC bind -- the ECM function registers the netdev
	# itself and does not wait for a host to enumerate -- so this is a short
	# wait, and a usb0 that never turns up means the gadget is not what this
	# service claims to have built. Wait for it before eend and fail on it:
	# the old code waited in a background subshell and `exit 0`-ed when usb0
	# was missing, so the service reported started with no USB ethernet.
	#
	# Address it statically so the host always finds the same address (matches
	# the installer). NetworkManager is told to leave usb0 alone -- see
	# dc1-networkmanager-usb0.conf.
	n=0
	while [ ! -e /sys/class/net/usb0 ] && [ "$n" -lt 20 ]; do
		n=$((n + 1)); sleep 0.5
	done
	[ -e /sys/class/net/usb0 ] || { eend 1 "usb0 did not appear"; return 1; }
	ip link set usb0 up 2>/dev/null
	ip addr show usb0 2>/dev/null | grep -q 'inet ' || \
		ip addr add "$DEV_IP/24" dev usb0 2>/dev/null

	eend 0
}

# Drop the gadget driver off the UDC. This is the whole of stop(): the tree
# stays standing, deliberately.
#
# The previous version tore the tree down in careful configfs order (unbind ->
# unlink functions from the config -> rmdir bottom-up), on the theory that the
# uninterruptible hangs came from removals arriving out of order. They do not.
# Measured on hardware 2026-08-17: with the UDC cleanly unbound, every function
# unlinked from c.1, the configs already gone, and no process holding
# /dev/ttyGS0 or /dev/ttyGS1 open, `rmdir functions/acm.0` still went to D state
# and stayed there. It cannot be signalled, so the mount is wedged for the rest
# of the boot -- and because it holds the parent directory's lock, every later
# configfs access blocks behind it too (a plain `find` over usb_gadget/ hung
# immediately). That is the same wedge blamed on usb-signaller on 2026-08-16,
# and it is what fails the suspend freezer: a D-state task can never be frozen.
#
# So do not remove gadget objects at all. Nothing needs them removed -- start()
# reuses and completes an existing tree -- and an unbound gadget already
# releases the USB bus. If the tree ever genuinely has to be rebuilt, reboot.
unbind() {
	[ -e "$G/UDC" ] || return 0
	[ -n "$(cat "$G/UDC" 2>/dev/null)" ] || return 0
	printf '\n' >"$G/UDC" 2>/dev/null
}

stop() {
	ebegin "Stopping the DC-1 USB gadget"
	[ -d "$G" ] && unbind
	eend 0
}
