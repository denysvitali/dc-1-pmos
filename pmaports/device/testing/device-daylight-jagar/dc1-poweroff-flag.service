# dc1-poweroff-flag.service -- the canonical systemd execute-at-shutdown
# hook: ExecStart consumes (clears) the clean-poweroff flag early in every
# boot, ExecStop records it again at every CLEAN shutdown. See
# dc1-poweroff-flag for the full lifecycle and dc1-charging-generator for
# the consumer side. DefaultDependencies=no plus the explicit shutdown
# ordering is the standard shape for a unit that must act while everything
# else stops (cf. alsa-store.service).
#
# Wanted by basic.target, NOT multi-user.target: charging mode requires
# basic.target but never reaches multi-user, and an unplug-poweroff from a
# charging session must record too -- otherwise plug -> charge -> unplug ->
# plug would boot the desktop on the second round.
#
# RequiresMountsFor keeps the flag's filesystem up until ExecStop has run;
# a failed record degrades safely (missing flag means one normal desktop
# boot, never an unsafe one).

[Unit]
Description=DC-1 clean-poweroff flag (consumed at boot, recorded at shutdown)
DefaultDependencies=no
After=local-fs.target
RequiresMountsFor=/var/lib/dc1
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/dc1-poweroff-flag consume
ExecStop=/usr/libexec/dc1-poweroff-flag record

[Install]
WantedBy=basic.target
