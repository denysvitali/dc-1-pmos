# Consume the previous clean-poweroff flag once in both desktop and charging
# boots, after generators have inspected it. No ExecStop: a service restart,
# reboot or kexec must never manufacture a clean-poweroff flag.
# dc1-poweroff-record.service records separately through poweroff.target.

[Unit]
Description=DC-1 consume clean-poweroff charging marker
DefaultDependencies=no
After=local-fs.target
RequiresMountsFor=/var/lib/dc1
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/dc1-poweroff-flag consume

[Install]
WantedBy=basic.target
