# DC-1 touch calibration, applied via libinput so it works under any Wayland
# compositor (sway reads it too; mutter needs it once the desktop migrates).
#
# The panel's 180-degree scanout transform physically rotates the touch grid,
# so without this matrix both axes land on the opposite side of the visible
# desktop. The value is the same matrix proven in dc1-sway.conf's
# calibration_matrix (hardware corner testing); sway's own config overrides
# this with the identical value, so there is no double-application.
#
# Matched generically (ID_INPUT_TOUCHSCREEN) rather than by controller name:
# the device has exactly one touchscreen, and its vendor driver is not
# characterized in the mainline DT (the touch node is intentionally unwritten
# there), so a name match would encode a guess.
ACTION=="add|change", SUBSYSTEM=="input", ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 -1 1"

# Mali-G57 devfreq responsiveness. simple_ondemand holds the GPU at its
# 390 MHz floor and re-evaluates only every 50 ms, so the first frames of
# every UI animation render at the floor and the clock catches up ~2-3
# frames late -- visible as jank at each animation start on the 60 Hz
# 1200x1600 panel. Sampling at 20 ms cuts the ramp lag to about one frame,
# and a 545 MHz floor (third of 36 OPPs, verified in
# available_frequencies) gives compositing headroom from the first frame.
# The floor is cheap: panfrost runtime-suspends the GPU 50 ms after the
# last job (autosuspend_delay_ms), so min_freq only applies while jobs
# are actually running, and thermal devfreq cooling still caps from the
# top unaffected (measured 2026-08-25: DVFS ramps 390->1100 MHz under
# load, all zones ~40 C, cooling state 0).
#
# The devfreq device appears when dc1-gpu re-probes the Mali node, well
# after coldplug, so this matches that late add event too.
ACTION=="add", SUBSYSTEM=="devfreq", KERNEL=="13000000.gpu", \
  ATTR{polling_interval}="20", ATTR{min_freq}="545000000"

# Hide the fuel gauge from UPower while it is mute. The BQ78Z100 at i2c-7
# 0x55 registers a power_supply and then NAKs every read (-ENXIO), so UPower
# publishes a battery with no usable property and GNOME renders
# "Battery Level: error: unknown" -- worse than showing nothing, because the
# device really does have a battery and the reading is simply unavailable.
#
# ATTR{present} is the one property that still reads: bq27xxx_battery.c
# reports 0 when its cached flags are an error, so this matches exactly the
# failed-communication case and stops matching the moment the gauge answers
# (P7.1). The MT6375 line-power supply is untouched, so AC state still shows.
SUBSYSTEM=="power_supply", KERNEL=="bq78z100-0", ATTR{present}=="0", ENV{UPOWER_IGNORE}="1"
