[org.gnome.settings-daemon.plugins.power]
# gnome-shell-mobile handles the power key itself -- it grabs it as a mutter
# keybinding ("DBus: disallowing the grabbing of power key accelerator"), so
# neither logind's HandlePowerKey nor gnome-settings-daemon ever sees it. On
# key release its misc/powerManager.js maps this setting:
#
#     let action = this._powerSettings.get_string('power-button-action');
#     if (action === 'nothing') { // FIXME: get rid of this in favor of new action
#         action = 'blank';
#     } else if (action === 'interactive') { this._showInteractivePowerMenu(); return; }
#
# 'nothing' is remapped to 'blank', which is the phone-like sleep/wake toggle
# we want: a short press locks the shield (see lock-enabled below) and
# DPMS-offs the panel, and the next short press cancels the running blank
# action and turns the screen back on at the lock screen -- powerManager
# swallows that wake press after cancelling, so one press toggles exactly
# once and cannot flap into an immediate re-blank. A >=2 s hold opens the
# quick-settings power menu. Suspend and hibernate are masked system-wide
# (see the sleep-target masks in the APKBUILD), so logind reports
# CanSuspend=no and the menu offers only restart/power off -- the s2idle path
# that aborts with unfreezable tasks stays unreachable.
power-button-action='nothing'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org.gnome.shell]
# The amber frontlight is a second RT4539 that GNOME cannot see: gsd-power
# binds one backlight device per internal display (firmware > platform > raw,
# first match), which is always the white channel. dc1-warmth adds the second
# quick-settings slider for it, as a share of the white level so it reads as a
# colour temperature. Enabled by default here; it is a user setting, so
# anything the user does in Extensions still wins.
enabled-extensions=['dc1-warmth@denv.it']

[org.gnome.shell.keybindings]
# The two spare side buttons, remapped by 61-daylight-jagar-keyboard.hwdb to
# XF86Launch1 (top-left "Quick Action") and XF86Launch2 (bottom-right "Back
# Button" / Walkie Talkie). Defaults: Quick Action opens the screenshot UI --
# 'Print' is kept so external keyboards still work -- and Back Button toggles
# the overview. Both are overrides of the schema *defaults*, so anything the
# user sets in GNOME Settings > Keyboard still wins.
show-screenshot-ui=['Print', 'XF86Launch1']
toggle-overview=['XF86Launch2']

[org.gnome.desktop.session]
# No spontaneous idle-blanking while unlocked: this key is what powerManager
# arms its screensaver idle watch from, and while the shield is down 0
# disables the watch entirely. With the shield up, powerManager ignores this
# value and uses a hardcoded 10 s timeout instead -- see the screensaver
# section below.
idle-delay=0

[org.gnome.desktop.screensaver]
# Lock on blank: the power button's blank action consults this key
# (powerManager.js case 'blank' calls screenShield.lock() before fading the
# panel out when this is true), so true is what turns a short press into
# "sleep" that also secures the device. Raising the shield makes powerManager
# arm a *hardcoded* 10 s idle watch instead of honouring idle-delay:
#
#     const idleTimeoutMs = Main.screenShield.active
#         ? 10 * 1000
#         : this._sessionSettings.get_uint('idle-delay') * 1000;
#
# so an untouched lock screen goes dark again 10 s after the last input,
# phone-style; any touch or keystroke (PIN entry included) resets it. Manual
# locking is unaffected: screenShield.lock() consults
# org.gnome.desktop.lockdown disable-lock-screen, not this key.
lock-enabled=true
