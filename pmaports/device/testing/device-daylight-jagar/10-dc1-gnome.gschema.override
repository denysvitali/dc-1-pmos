[org.gnome.settings-daemon.plugins.power]
# GNOME Mobile 51 uses the native toggle-blank action for the power key.
# Keep GNOME's suspend timers disabled; dc1-sleep-on-blank remains opt-in.
power-button-action='toggle-blank'
# A reflective panel needs more frontlight in darkness. GNOME retains its
# native sensor claim, smoothing, manual brightness bias and dimming.
ambient-inverted=true
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org.gnome.mutter.experimental]
# 120 Hz compositing (measured 2026-08-27): KMS planes only advertise
# LINEAR + rotate-0/180, so landscape is a GPU offscreen blit, and the
# 1200x1600@120 mode has 0.31 ms of vblank (vtotal 1662). GBM modifiers
# let Panfrost use tiled intermediates for that blit; without the flag
# mutter stays on linear copies. Schema default only -- Settings still
# wins if the user disables kms-modifiers.
kms-modifiers=true

[org.gnome.shell]
# The amber frontlight is a second RT4539 that GNOME cannot see: gsd-power
# binds one backlight device per internal display (firmware > platform > raw,
# first match), which is always the white channel. dc1-warmth adds the second
# quick-settings slider as a colour-temperature crossfade over one shared
# luminance: pure white at 0, pure amber (white off) at 1, with GNOME's own
# brightness controls setting the overall level. Enabled by default here; it
# is a user setting, so
# anything the user does in Extensions still wins.
#
# dc1-safe-area pads the top bar and on-screen keyboard away from the
# bezel, which overlaps the outer ~10 device px of the panel on every edge
# (measured 2026-08-25 with on-glass calibration rulers).
enabled-extensions=['dc1-warmth@denv.it', 'dc1-safe-area@denv.it']

[org.gnome.shell.keybindings]
# The two spare side buttons, remapped by 61-daylight-jagar-keyboard.hwdb to
# XF86Launch1 (top-left "Quick Action") and XF86Launch2 (bottom-right "Back
# Button" / Walkie Talkie). Defaults: Quick Action opens the screenshot UI --
# 'Print' is kept so external keyboards still work -- and Back Button toggles
# the overview. Both are overrides of the schema *defaults*, so anything the
# user sets in GNOME Settings > Keyboard still wins.
show-screenshot-ui=['Print', 'XF86Launch1']
toggle-overview=['XF86Launch2']

[org.gnome.desktop.session]
# Blank and lock after five minutes without input. The separate opt-in
# dc1-sleep-on-blank service handles suspend after another minute on battery;
# GNOME's own suspend timers remain disabled.
idle-delay=300

[org.gnome.desktop.screensaver]
# Lock when the panel blanks; a power-key wake returns to the lock screen.
lock-enabled=true

[org.gnome.desktop.a11y.applications]
# The DC-1 has no built-in keyboard, and GDM's greeter has no other text
# input: its dconf profile reads only the gdm user db and gdm's own
# greeter-dconf-defaults (which carries no a11y keys), so the greeter falls
# back to this schema default. Left at false, any logout strands the device
# on a password prompt that cannot be typed -- autologin only fires once per
# gdm daemon start, so it does not re-trigger after a normal logout
# (recovery is `systemctl restart gdm`, which needs a root shell the greeter
# cannot give you). Measured 2026-08-25 on this device. As a schema default
# it also gives the dc1 session an on-screen keyboard, which is correct for
# a keyboard-less tablet; GNOME suppresses it while a physical keyboard is
# attached, and Settings > Accessibility still wins.
screen-keyboard-enabled=true
