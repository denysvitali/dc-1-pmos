#!/bin/sh
# Register the DC-1 boot + debug services. Best-effort and idempotent: each
# service fails safely (panel stays dark / no shell) if absent.

# Signing keys, so apk can verify an index (see the helper for why this is
# shared with post-upgrade rather than written out here).
[ -x /usr/libexec/dc1-link-apk-keys ] && /usr/libexec/dc1-link-apk-keys

rc-update add dc1-display-gate boot 2>/dev/null || true
rc-update add dc1-gpu boot 2>/dev/null || true
rc-update add dc1-frontlight default 2>/dev/null || true
rc-update add dc1-screen-backlight default 2>/dev/null || true
rc-update add dc1-rtcsync default 2>/dev/null || true
rc-update add dc1-usb-gadget boot 2>/dev/null || true
rc-update add dc1-debug-shell default 2>/dev/null || true
# sshd: register it in the default runlevel directly. openssh-server is a hard
# depends of this package, so apk installs it BEFORE this post-install runs --
# /etc/init.d/sshd is guaranteed present, which removes the install-order
# fragility the earlier `use sshd` soft-dep was trying to dodge. That soft-dep
# was observed NOT to start sshd at boot (it sat "stopped" until started by
# hand), so it is not sufficient.
if [ -x /etc/init.d/sshd ]; then
	rc-update add sshd default 2>/dev/null || true
fi

# Compile the gschema overrides (including ours: the power key opens the power
# menu instead of blanking, and nothing idle-blanks or sleeps) so the GNOME
# power defaults take effect. Best-effort: only relevant when a GNOME desktop
# is installed.
glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
exit 0
