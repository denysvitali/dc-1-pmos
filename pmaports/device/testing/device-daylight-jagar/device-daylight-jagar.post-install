#!/bin/sh
# Register the DC-1 boot + debug services. Best-effort and idempotent: each
# service fails safely (panel stays dark / no shell) if absent.
rc-update add dc1-display-gate boot 2>/dev/null || true
rc-update add dc1-frontlight default 2>/dev/null || true
rc-update add dc1-usb-gadget boot 2>/dev/null || true
rc-update add dc1-debug-shell default 2>/dev/null || true
# sshd is started via a `use sshd` soft dependency in dc1-debug-shell (not
# registered here) -- a post-install rc-update is fragile against package
# install order, and Alpine ships no sshd runlevel registration of its own.
exit 0
