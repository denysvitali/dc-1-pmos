#!/bin/sh
# dc1-shell-rt -- restore mutter's realtime KMS thread via rtkit.
#
# Mutter asks RealtimeKit to schedule its KMS thread SCHED_RR so frame
# submission cannot be preempted by ordinary load, and prepares for the
# grant by setting RLIMIT_RTTIME (200 ms, rtkit's RTTimeUSecMax) on the
# shell process. On this image the grant never sticks: both the gdm
# greeter shell and the user session shell run the thread at
# SCHED_OTHER|SCHED_RESET_ON_FORK while rtkit itself is healthy -- the
# same MakeThreadRealtimeWithPID call from a plain unprivileged process
# of the same user is granted immediately, and PipeWire's data-loop
# threads hold live SCHED_RR grants from the same daemon (measured
# 2026-08-25). The failure is specific to mutter's own startup request,
# not rtkit policy, and the process rlimit mutter leaves behind proves
# it got as far as preparing the request.
#
# Until that is root-caused in mutter, this per-user service watches the
# manager's gnome-shell and re-issues the grant. It is idempotent: a
# thread already SCHED_RR is left alone, so if a future mutter's own
# request starts working this loop never fires. rtkit demotion (its
# starvation watchdog resets threads to SCHED_OTHER|SCHED_RESET_ON_FORK)
# is also healed by the same re-check.
#
# Priority 20 matches rtkit's default MaxRealtimePriority: the value
# PipeWire is granted on this image and the ceiling mutter requests.

PRIO=20

boost_shell() {
	pid="$1"
	for task in /proc/"$pid"/task/*; do
		[ -e "$task"/comm ] || continue
		[ "$(cat "$task"/comm 2>/dev/null)" = "KMS thread" ] || continue
		tid=${task##*/}
		chrt -p "$tid" 2>/dev/null | grep -q SCHED_RR && continue
		busctl --system call org.freedesktop.RealtimeKit1 \
			/org/freedesktop/RealtimeKit1 \
			org.freedesktop.RealtimeKit1 \
			MakeThreadRealtimeWithPID ttu "$pid" "$tid" "$PRIO" \
			>/dev/null 2>&1 || continue
		echo "gnome-shell $pid KMS thread $tid granted SCHED_RR $PRIO"
	done
}

uid="$(id -u)"
while :; do
	for pid in $(pgrep -u "$uid" -x gnome-shell); do
		boost_shell "$pid"
	done
	sleep 5
done
