#!/sbin/openrc-run
# dc1-bluetooth -- recover the MT7902 Bluetooth controller from the boot-time
# firmware race.
#
# btmtksdio is built into the kernel (=y), so it probes as soon as the SDIO
# function is enumerated -- measured on hardware at t=1.75 s, well before the
# root filesystem carrying /lib/firmware is in place. The request for
# mediatek/BT_RAM_CODE_MT7902_1_1_hdr.bin comes back -2 ("Direct firmware load
# ... failed with error -2"), btmtk gives up with "Failed to setup 79xx firmware
# (-2)", and hci0 stays registered but never completes setup. The symptom is
# not an obvious error: /sys/class/bluetooth/hci0 and the rfkill switch both
# exist, so everything looks present, while bluetoothctl answers "No default
# controller available" and nothing can be paired. The Wi-Fi side of the same
# chip survives the identical race only because mt7921s retries the load on its
# own; btmtksdio makes one attempt and stops.
#
# By the time a service can run, the rootfs is mounted and the blob is there,
# so one unbind/bind of the SDIO function is all it takes. Verified on hardware
# 2026-08-17: rebinding mmc1:0001:2 completed setup in 2.75 s and brought the
# controller up as "Daylight DC-1".
#
# The race DOES have a winning side now: jagar-boot.img stages the blob in the
# system initramfs (installer/build.sh), so on a current boot image btmtksdio's
# single attempt succeeds and there is nothing to repair. The rebind therefore
# runs only when the kernel actually logged the failure it repairs -- hci0
# itself still looks identical either way, so the log line is the only honest
# discriminator, and rebinding a healthy controller would drop and re-setup a
# working one for no reason. Kept as the repair path for boot images that
# predate the staging, and for any future regression in it.

description="Recover the MT7902 Bluetooth controller after the firmware race"

DRV=/sys/bus/sdio/drivers/btmtksdio
FAIL_SIG="Failed to setup 79xx firmware"

depend() {
	need localmount
	before bluetooth
}

start() {
	ebegin "Rebinding the MT7902 Bluetooth controller"

	# dmesg is the discriminator. If the ring has already wrapped past the
	# message (long uptime, manual re-run) this does nothing -- the same
	# outcome as a healthy boot, which is the safe direction to fail.
	if ! dmesg 2>/dev/null | grep -q "$FAIL_SIG"; then
		eend 0
		return 0
	fi

	# No Bluetooth SDIO function bound: nothing to recover, and not an error
	# (the driver may be absent, or the chip already rebound by an earlier run).
	dev=$(find "$DRV" -maxdepth 1 -mindepth 1 -name 'mmc*' -exec basename {} \; \
		2>/dev/null | head -1)
	if [ -z "$dev" ]; then
		eend 0
		return 0
	fi

	printf '%s\n' "$dev" >"$DRV/unbind" 2>/dev/null \
		|| { eend 1 "btmtksdio unbind failed for $dev"; return 1; }

	# The SDIO core needs a moment to drop the function before it will take it
	# back; binding immediately can race the teardown.
	sleep 1

	printf '%s\n' "$dev" >"$DRV/bind" 2>/dev/null \
		|| { eend 1 "btmtksdio bind failed for $dev"; return 1; }

	# Setup runs asynchronously after bind and took 2.75 s on hardware. Wait
	# for it so bluetoothd, ordered after this, starts with a live controller.
	n=0
	while [ ! -e /sys/class/bluetooth/hci0 ] && [ "$n" -lt 20 ]; do
		n=$((n + 1)); sleep 0.5
	done
	[ -e /sys/class/bluetooth/hci0 ] \
		|| { eend 1 "hci0 did not come back after the rebind"; return 1; }

	eend 0
}
