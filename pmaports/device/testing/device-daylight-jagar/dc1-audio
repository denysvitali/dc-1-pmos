#!/bin/sh
# dc1-audio -- give the device an ALSA card. Systemd helper; the OpenRC path is
# dc1-audio.initd, which carries the same sequence and its rationale.

# On a mainline-DT boot (dtbswap) the tree wires the AFE itself: the card is
# up before this unit runs and the stock-tree overlay correctly refuses to
# apply (-19). Only the stock tree needs the overlay + re-probe dance.
if ! grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null; then
	# The braces are load-bearing: `a || b; exit 1` parses as
	# `(a || b); exit 1`, so the exit fires whether or not modprobe
	# succeeded (see dc1-gpu.initd).
	modprobe mt6789-live-audio-overlay 2>/dev/null \
		|| { echo "could not load the audio overlay module" >&2; exit 1; }

	# Re-probe the AFE. Its boot probe gave up (-110) waiting for an AUDIO
	# power domain that had no provider; the overlay adds one, but the
	# deferred probe is long over, so the device must be poked to retry.
	printf '11210000.mt6789-afe-pcm\n' > /sys/bus/platform/drivers_probe 2>/dev/null \
		|| { echo "drivers_probe write failed" >&2; exit 1; }
fi

# The machine card binds only once the AFE component registers, so wait for the
# card itself rather than for the AFE device: that is what userspace needs. Match
# it by name -- a card index says nothing about which card turned up.
n=0
while ! grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null && [ "$n" -lt 10 ]; do
	n=$((n + 1)); sleep 1
done
grep -q mt6789-mt6366 /proc/asound/cards 2>/dev/null \
	|| { echo "the mt6789-mt6366 card did not appear" >&2; exit 1; }

# Wire the speaker path. Without a UCM profile PipeWire leaves the DAPM
# selectors at their reset values ("Open" for HPL/HPR Mux) and the RT9101
# amp switch off, so nothing reaches the speakers. Set them once at startup;
# they persist until the card is removed.
#   DL1 PCM → ADDA_DL CH1/CH2 → HPL/HPR (LoudSPK Playback)
#           → Ext_Speaker_Amp → RT9101 → speakers
# Headphone is the master gain (+8 dB = value 18) and drives both channels
# equally. The speakers are asymmetric off the codec: one runs through an
# extra line-out (LOL) buffer gain stage, the other through the headphone DAC
# directly, so the two can drift apart. Lineout is that stage; +2 dB (value
# 12) is the hardware-matched trim -- at 0 dB the buffer speaker reads
# quieter, at +8 dB it reads louder (and clips). There is no factory value to
# port: Android drove both speakers through one mono `speaker_pga` knob, so it
# never expressed a per-channel trim. This unit must run AFTER alsa-restore,
# which otherwise restores the saved mute state (the codec ramps to mute on
# stop and alsactl stores that) and clobbers these gains -- see the .service
# ordering.
_set_speaker_path() {
	local c="amixer -c mt6789mt6366 -q"
	$c sset 'ADDA_DL_CH1 DL1_CH1' on \
	&& $c sset 'ADDA_DL_CH2 DL1_CH2' on \
	&& $c sset 'HPL Mux' 'LoudSPK Playback' \
	&& $c sset 'HPR Mux' 'LoudSPK Playback' \
	&& $c sset 'Ext_Speaker_Amp' on \
	&& $c sset 'Headphone' 18 \
	&& $c sset 'Lineout' 12 \
	&& $c sset 'ADDA_DL_GAIN' 100%
}
_set_speaker_path || echo "dc1-audio: speaker path amixer commands failed" >&2
