#!/bin/sh
# dc1-frontlight -- raise the DC-1 white frontlight once the compositor is up.
# Systemd helper; the OpenRC path is dc1-frontlight.initd, which carries the
# same sequence and rationale.
#
# The rt4539 frontlight boots at 0, so a correctly scanned-out frame is
# invisible. It must come up only after a frame is composited. This first-light
# version waits for gnome-shell plus a short grace for its first frame; the
# amber channel is left alone on purpose.

n=0
while ! pidof gnome-shell >/dev/null 2>&1; do
	n=$((n + 1))
	[ "$n" -ge 30 ] && break
	sleep 1
done
sleep 3
echo 10 > /sys/class/backlight/lcd-backlight/brightness 2>/dev/null
