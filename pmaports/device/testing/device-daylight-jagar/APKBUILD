maintainer="Denys Vitali <denys@denv.it>"
pkgname=device-daylight-jagar
pkgdesc="Daylight Computer DC-1"
pkgver=1
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# MT7902 Wi-Fi/BT firmware comes from upstream linux-firmware
# (mediatek/WIFI_RAM_CODE_MT7902_1.bin, WIFI_MT7902_patch_mcu_1_1_hdr.bin,
# BT_RAM_CODE_MT7902_1_1_hdr.bin) and regulatory.db from wireless-regdb.
depends="
	linux-firmware-mediatek
	linux-postmarketos-mediatek-mt6789
	openssh-server
	postmarketos-base
	wireless-regdb
"
makedepends="devicepkg-dev"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	deviceinfo
	dc1-display-gate.initd
	dc1-frontlight.initd
	dc1-gpu.initd
	dc1-debug-shell.initd
	dc1-usb-gadget.initd
	dc1-networkmanager-usb0.conf
	dc1-sway.conf
	00-logo-key.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# The display gate: open the panel at runtime with no modeset, so the
	# compositor is the first DRM master. Device-specific (panel driver module
	# params, GCE/DSI addresses), so it lives here, not in a UI package.
	install -Dm755 "$srcdir"/dc1-display-gate.initd \
		"$pkgdir"/etc/init.d/dc1-display-gate
	install -Dm755 "$srcdir"/dc1-frontlight.initd \
		"$pkgdir"/etc/init.d/dc1-frontlight
	install -Dm755 "$srcdir"/dc1-gpu.initd \
		"$pkgdir"/etc/init.d/dc1-gpu

	# USB gadget (ECM ethernet + 2x ACM) + the debug shells it carries.
	install -Dm755 "$srcdir"/dc1-usb-gadget.initd \
		"$pkgdir"/etc/init.d/dc1-usb-gadget
	install -Dm755 "$srcdir"/dc1-debug-shell.initd \
		"$pkgdir"/etc/init.d/dc1-debug-shell
	install -Dm644 "$srcdir"/dc1-networkmanager-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/60-dc1-usb0.conf

	# Panel output + touch transform for the default (sway) compositor.
	install -Dm644 "$srcdir"/dc1-sway.conf \
		"$pkgdir"/etc/sway/config.d/00-dc1-output.conf
	# Satisfy upstream's unconditional include (see the file's header).
	install -Dm644 "$srcdir"/00-logo-key.conf \
		"$pkgdir"/etc/sway/config.d/00-logo-key.conf
}

