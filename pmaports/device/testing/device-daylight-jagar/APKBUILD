maintainer="Denys Vitali <denys@denv.it>"
pkgname=device-daylight-jagar
pkgdesc="Daylight Computer DC-1"
pkgver=1
pkgrel=88
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# MT7902 Wi-Fi/BT firmware comes from upstream linux-firmware
# (mediatek/WIFI_RAM_CODE_MT7902_1.bin, WIFI_MT7902_patch_mcu_1_1_hdr.bin,
# BT_RAM_CODE_MT7902_1_1_hdr.bin) and regulatory.db from wireless-regdb.
#
# pipewire-pulse: GNOME (gnome-shell / gnome-control-center) is a libpulse
# client, and the image's pulseaudio backend never starts under systemd
# (its autostart entry is hidden), so without this package there is no
# PulseAudio server socket and the GNOME Sound panel lists no devices at
# all. Its user socket unit is already enabled in sockets.target.wants by
# the base install; only the binary/service package is needed.
depends="
	alsa-utils
	curl
	gnome-settings-daemon-mobile
	gtk4.0
	iio-sensor-proxy
	libadwaita
	linux-firmware-mediatek
	linux-postmarketos-mediatek-mt6789
	openssh-server
	pipewire-pulse
	polkit
	postmarketos-base
	py3-dbus
	py3-gobject3
	python3
	wireless-regdb
"
# linux-headers: build-time only, for dc1-pwrkey's kernel input UAPI includes
# and dc1-mn29-probe's I2C UAPI includes. Nothing is added to the installed
# image.
makedepends="devicepkg-dev linux-headers"
# This package ships its own /etc/gdm/custom.conf (autologin to dc1), which
# gdm's meson install also installs as a default. `replaces` lets our file
# win the apk conflict without removing gdm -- the same pattern
# postmarketos-ui-os-installer uses to override gdm's custom.conf.
replaces="gdm"
install="$pkgname.post-install $pkgname.post-upgrade"
# Fire dc1-boot-sync --deploy when the kernel apk drops a new kernel, so
# `apk upgrade` arms the inactive slot before the reboot. Also re-apply the
# WirePlumber Dummy Output guard when alsa.lua is replaced by a wireplumber
# upgrade (that script concatenates a nil node.name on bind failure).
triggers="$pkgname.trigger=/boot/vmlinuz:/usr/share/kernel/*:/usr/share/wireplumber/scripts/monitors/alsa.lua"
source="
	deviceinfo
	dc1-display-gate.initd
	dc1-frontlight.initd
	dc1-screen-backlight.initd
	dc1-gpu.initd
	dc1-audio.initd
	dc1-rtcsync.initd
	dc1-debug-shell.initd
	dc1-usb-gadget.initd
	dc1-bluetooth.initd
	dc1-networkmanager-usb0.conf
	50-wwan-policy.conf
	10-dc1-bluetooth-directory.conf
	10-dc1-modemmanager.conf
	dc1-sway.conf
	00-logo-key.conf
	dc1-reboot-fastboot.c
	dc1-misc.c
	dc1-misc.h
	dc1-slotctl.c
	dc1-pwrkey.c
	dc1-mn29-probe.c
	dc1-boot-sync
	dc1-boot-sync.service
	device-daylight-jagar.trigger
	dc1-link-apk-keys
	dc1-usb-gadget
	dc1-usb-gadget.service
	dc1-debug-shell
	dc1-debug-shell.service
	dc1-display-gate
	dc1-display-gate.service
	dc1-gpu
	dc1-gpu.service
	dc1-gpu-freq
	dc1-gpu-settings
	dc1-gpu-settings.desktop
	it.denv.dc1.gpufreq.policy
	dc1-audio
	dc1-audio.service
	dc1-fix-wireplumber-alsa
	dc1-ucm-card.conf
	dc1-ucm-hifi.conf
	55-dc1-audio.conf
	10-dc1-localsearch.conf
	dc1-bluetooth
	dc1-bluetooth.service
	dc1-frontlight
	dc1-frontlight.service
	dc1-screen-backlight
	dc1-screen-backlight.service
	dc1-rtcsync.service
	dc1-rtcsync.timer
	80-device-daylight-jagar.preset
	90-device-daylight-jagar.rules
	10-dc1-watchdog.conf
	10-dc1-gnome.gschema.override
	61-daylight-jagar-keyboard.hwdb
	daylight-dc1.tablet
	10-dc1-power.conf
	49-device-daylight-jagar-sensors.rules
	dc1-orientation
