maintainer="Denys Vitali <denys@denv.it>"
pkgname=device-daylight-jagar
pkgdesc="Daylight Computer DC-1"
pkgver=1
pkgrel=55
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# MT7902 Wi-Fi/BT firmware comes from upstream linux-firmware
# (mediatek/WIFI_RAM_CODE_MT7902_1.bin, WIFI_MT7902_patch_mcu_1_1_hdr.bin,
# BT_RAM_CODE_MT7902_1_1_hdr.bin) and regulatory.db from wireless-regdb.
depends="
	alsa-utils
	curl
	gnome-settings-daemon-mobile
	gtk+3.0
	iio-sensor-proxy
	linux-firmware-mediatek
	linux-postmarketos-mediatek-mt6789
	openssh-server
	postmarketos-base
	py3-dbus
	py3-gobject3
	python3
	wireless-regdb
"
makedepends="devicepkg-dev"
# This package ships its own /etc/gdm/custom.conf (autologin to dc1), which
# gdm's meson install also installs as a default. `replaces` lets our file
# win the apk conflict without removing gdm -- the same pattern
# postmarketos-ui-os-installer uses to override gdm's custom.conf.
replaces="gdm"
install="$pkgname.post-install $pkgname.post-upgrade"
# Fire dc1-boot-sync --deploy when the kernel apk drops a new kernel, so
# `apk upgrade` arms the inactive slot before the reboot. The watched paths
# are what the kernel package installs on every upgrade.
triggers="$pkgname.trigger=/boot/vmlinuz:/usr/share/kernel/*"
source="
	deviceinfo
	dc1-display-gate.initd
	dc1-frontlight.initd
	dc1-screen-backlight.initd
	dc1-gpu.initd
	dc1-audio.initd
	dc1-rtcsync.initd
	dc1-debug-shell.initd
	dc1-usb-gadget.initd
	dc1-bluetooth.initd
	dc1-networkmanager-usb0.conf
	dc1-sway.conf
	00-logo-key.conf
	dc1-reboot-fastboot.c
	dc1-misc.c
	dc1-misc.h
	dc1-slotctl.c
	dc1-boot-sync
	dc1-boot-sync.service
	device-daylight-jagar.trigger
	dc1-link-apk-keys
	dc1-usb-gadget
	dc1-usb-gadget.service
	dc1-debug-shell
	dc1-debug-shell.service
	dc1-display-gate
	dc1-display-gate.service
	dc1-gpu
	dc1-gpu.service
	dc1-audio
	dc1-audio.service
	dc1-bluetooth
	dc1-bluetooth.service
	dc1-frontlight
	dc1-frontlight.service
	dc1-screen-backlight
	dc1-screen-backlight.service
	dc1-rtcsync.service
	dc1-rtcsync.timer
	80-device-daylight-jagar.preset
	90-device-daylight-jagar.rules
	10-dc1-watchdog.conf
	10-dc1-gnome.gschema.override
	61-daylight-jagar-keyboard.hwdb
	10-dc1-power.conf
	49-device-daylight-jagar-sensors.rules
	dc1-orientation
	dc1-orientation.desktop
	dc1-orientation.service
	net.hadess.SensorProxy.service
	dc1-warmth-extension.js
	dc1-warmth-metadata.json
	org.gnome.shell.extensions.dc1-warmth.gschema.xml
	dc1-link-apk-keys.service
	dc1-first-boot
	dc1-first-boot.service
	dc1-apk.rsa.pub
	dc1-pmos.list
	gdm-custom.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"

	# No tarball, so no $builddir to compile in -- keep both ends in
	# $srcdir, where abuild has already put the source. Both C tools share
	# dc1-misc.c (the PARTNAME=misc resolver): one implementation of the
	# safety-critical partition lookup, not one per tool.
	# shellcheck disable=SC2086
	${CC:-gcc} $CFLAGS $LDFLAGS -o "$srcdir"/dc1-reboot-fastboot \
		"$srcdir"/dc1-reboot-fastboot.c "$srcdir"/dc1-misc.c
	${CC:-gcc} $CFLAGS $LDFLAGS -o "$srcdir"/dc1-slotctl \
		"$srcdir"/dc1-slotctl.c "$srcdir"/dc1-misc.c
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# The display gate: open the panel at runtime with no modeset, so the
	# compositor is the first DRM master. Device-specific (panel driver module
	# params, GCE/DSI addresses), so it lives here, not in a UI package.
	install -Dm755 "$srcdir"/dc1-link-apk-keys \
		"$pkgdir"/usr/libexec/dc1-link-apk-keys
	install -Dm755 "$srcdir"/dc1-display-gate.initd \
		"$pkgdir"/etc/init.d/dc1-display-gate
	install -Dm755 "$srcdir"/dc1-frontlight.initd \
		"$pkgdir"/etc/init.d/dc1-frontlight
	install -Dm755 "$srcdir"/dc1-screen-backlight.initd \
		"$pkgdir"/etc/init.d/dc1-screen-backlight
	install -Dm755 "$srcdir"/dc1-gpu.initd \
		"$pkgdir"/etc/init.d/dc1-gpu
	install -Dm755 "$srcdir"/dc1-audio.initd \
		"$pkgdir"/etc/init.d/dc1-audio
	install -Dm755 "$srcdir"/dc1-bluetooth.initd \
		"$pkgdir"/etc/init.d/dc1-bluetooth
	install -Dm755 "$srcdir"/dc1-rtcsync.initd \
		"$pkgdir"/etc/init.d/dc1-rtcsync

	# USB gadget (ECM ethernet + 2x ACM) + the debug shells it carries.
	install -Dm755 "$srcdir"/dc1-usb-gadget.initd \
		"$pkgdir"/etc/init.d/dc1-usb-gadget
	install -Dm755 "$srcdir"/dc1-debug-shell.initd \
		"$pkgdir"/etc/init.d/dc1-debug-shell
	install -Dm644 "$srcdir"/dc1-networkmanager-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/60-dc1-usb0.conf

	# Panel output + touch transform for the default (sway) compositor.
	install -Dm644 "$srcdir"/dc1-sway.conf \
		"$pkgdir"/etc/sway/config.d/00-dc1-output.conf
	# Satisfy upstream's unconditional include (see the file's header).
	install -Dm644 "$srcdir"/00-logo-key.conf \
		"$pkgdir"/etc/sway/config.d/00-logo-key.conf

	# systemd units run alongside the OpenRC init scripts; the runtime init
	# system uses whichever it knows. The .service files exec the helpers in
	# /usr/libexec, which carry the same sequences as the .initd files.
	install -Dm755 "$srcdir"/dc1-usb-gadget "$pkgdir"/usr/libexec/dc1-usb-gadget
	install -Dm755 "$srcdir"/dc1-debug-shell "$pkgdir"/usr/libexec/dc1-debug-shell
	install -Dm755 "$srcdir"/dc1-display-gate "$pkgdir"/usr/libexec/dc1-display-gate
	install -Dm755 "$srcdir"/dc1-gpu "$pkgdir"/usr/libexec/dc1-gpu
	install -Dm755 "$srcdir"/dc1-audio "$pkgdir"/usr/libexec/dc1-audio
	install -Dm755 "$srcdir"/dc1-bluetooth "$pkgdir"/usr/libexec/dc1-bluetooth
	install -Dm755 "$srcdir"/dc1-frontlight "$pkgdir"/usr/libexec/dc1-frontlight
	install -Dm755 "$srcdir"/dc1-screen-backlight \
		"$pkgdir"/usr/libexec/dc1-screen-backlight
	install -Dm644 "$srcdir"/dc1-usb-gadget.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-usb-gadget.service
	install -Dm644 "$srcdir"/dc1-debug-shell.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-debug-shell.service
	install -Dm644 "$srcdir"/dc1-display-gate.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-display-gate.service
	install -Dm644 "$srcdir"/dc1-gpu.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-gpu.service
	install -Dm644 "$srcdir"/dc1-audio.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-audio.service
	install -Dm644 "$srcdir"/dc1-bluetooth.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-bluetooth.service
	# D-Bus activation for iio-sensor-proxy, which Alpine's aport omits -- see
	# the file's header. Without it the accelerometer reaches no compositor.
	install -Dm644 "$srcdir"/net.hadess.SensorProxy.service \
		"$pkgdir"/usr/share/dbus-1/system-services/net.hadess.SensorProxy.service
	install -Dm644 "$srcdir"/dc1-frontlight.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-frontlight.service
	install -Dm644 "$srcdir"/dc1-screen-backlight.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-screen-backlight.service
	install -Dm644 "$srcdir"/dc1-rtcsync.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-rtcsync.service
	install -Dm644 "$srcdir"/dc1-rtcsync.timer \
		"$pkgdir"/usr/lib/systemd/system/dc1-rtcsync.timer
	install -Dm644 "$srcdir"/80-device-daylight-jagar.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-device-daylight-jagar.preset
	install -Dm644 "$srcdir"/10-dc1-watchdog.conf \
		"$pkgdir"/etc/systemd/system.conf.d/10-dc1-watchdog.conf
	install -Dm644 "$srcdir"/49-device-daylight-jagar-sensors.rules \
		"$pkgdir"/etc/polkit-1/rules.d/49-device-daylight-jagar-sensors.rules
	install -Dm755 "$srcdir"/dc1-orientation \
		"$pkgdir"/usr/libexec/dc1-orientation
	install -Dm644 "$srcdir"/dc1-orientation.desktop \
		"$pkgdir"/etc/xdg/autostart/dc1-orientation.desktop
	install -Dm644 "$srcdir"/dc1-orientation.service \
		"$pkgdir"/usr/lib/systemd/user/dc1-orientation.service

	# The power key must not reach a sleep path, and must not blank a panel
	# whose frontlight stays lit: logind ignores the keys, and the gschema
	# override turns the shell's own power-key action into its power menu.
	# See the two files for the rationale and the shell source it quotes.
	install -Dm644 "$srcdir"/10-dc1-power.conf \
		"$pkgdir"/etc/systemd/logind.conf.d/10-dc1-power.conf
	install -Dm644 "$srcdir"/10-dc1-gnome.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/10-dc1-gnome.gschema.override

	# Side buttons: remap Quick Action / Back Button (F12/F11 in the keypad's
	# DT keymap) to XF86Launch1/XF86Launch2 so they are free for the user to
	# bind in GNOME Settings; defaults live in the gschema override above.
	install -Dm644 "$srcdir"/61-daylight-jagar-keyboard.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/61-daylight-jagar-keyboard.hwdb

	# The amber frontlight's quick-settings slider. GNOME binds exactly one
	# backlight device to the internal display, so the second RT4539 is
	# invisible to Settings; the extension drives it as a ratio of the white
	# channel (a colour temperature, not a second brightness). Its schema goes
	# to the system schema dir, which post-install recompiles anyway for the
	# override above.
	install -Dm644 "$srcdir"/dc1-warmth-extension.js \
		"$pkgdir"/usr/share/gnome-shell/extensions/dc1-warmth@denv.it/extension.js
	install -Dm644 "$srcdir"/dc1-warmth-metadata.json \
		"$pkgdir"/usr/share/gnome-shell/extensions/dc1-warmth@denv.it/metadata.json
	install -Dm644 "$srcdir"/org.gnome.shell.extensions.dc1-warmth.gschema.xml \
		"$pkgdir"/usr/share/glib-2.0/schemas/org.gnome.shell.extensions.dc1-warmth.gschema.xml

	# Suspend is not merely unsupported here, it is harmful: the s2idle path
	# aborts after ~20 s with user-space tasks refusing to freeze and returns
	# with the panel dark. Masking the sleep targets makes logind answer
	# CanSuspend/CanHibernate "no", which is what GNOME's power menu keys off,
	# so the entries are absent instead of failing when tapped. Drop these
	# masks when suspend/resume actually works (docs/status.md).
	install -d "$pkgdir"/etc/systemd/system
	for target in suspend sleep hibernate hybrid-sleep suspend-then-hibernate; do
		ln -s /dev/null "$pkgdir"/etc/systemd/system/"$target".target
	done

	# Exactly one thing may own the UDC. usb-signaller (pulled in by
	# postmarketos-usb-moded) starts after dc1-usb-gadget has already built g1
	# and bound musb-hdrc.1.auto, fails to recognise our functions ("Cannot
	# determine mode for gadget function acm.0"), and then tries to switch the
	# UDC to its own developer-mode gadget. That teardown wedges in configfs:
	# on 2026-08-16 it sat in D state (unlinkat/AT_REMOVEDIR) from boot,
	# blocked every later configfs access, and -- since an uninterruptible task
	# cannot be frozen -- failed the s2idle freezer on every attempt. Mask it
	# and its mode units; our own gadget provides the ECM + 2x ACM the
	# installer and the recovery path expect.
	for unit in usb-signaller usb-signaller-developer-mode \
		usb-signaller-mtp-mode usb-signaller-tethering-mode; do
		ln -s /dev/null "$pkgdir"/etc/systemd/system/"$unit".service
	done

	# apk signing keys (linked on-device at boot) and the first-boot desktop
	# app install. The .service files are systemd units; the helper scripts
	# they exec live in /usr/libexec alongside the other dc1 helpers.
	install -Dm644 "$srcdir"/dc1-link-apk-keys.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-link-apk-keys.service
	install -Dm644 "$srcdir"/dc1-first-boot.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-first-boot.service
	install -Dm755 "$srcdir"/dc1-first-boot \
		"$pkgdir"/usr/libexec/dc1-first-boot

	# The DC-1 repository signing key and repo line. apk trusts this key to
	# verify our APKINDEX (built and signed by CI with the matching private
	# key, held in the DC1_APK_PRIVATE_KEY secret), and the repo line makes
	# `apk update`/`apk upgrade` pull device/kernel updates from the GitHub
	# release over the network instead of re-flashing. Installed to
	# /usr/share/apk/keys (the alpine-keys layout), NOT /etc/apk/keys:
	# pmbootstrap bind-mounts its own key store over /etc/apk/keys in every
	# chroot, so a file packaged there lands in the host work directory and
	# the exported rootfs ships without it (that broke self-update once).
	# dc1-link-apk-keys links everything in /usr/share/apk/keys into
	# /etc/apk/keys at boot and on install/upgrade, which restores this key
	# on real devices where no bind mount is in the way.
	install -Dm644 "$srcdir"/dc1-apk.rsa.pub \
		"$pkgdir"/usr/share/apk/keys/dc1-apk.rsa.pub
	install -Dm644 "$srcdir"/dc1-pmos.list \
		"$pkgdir"/etc/apk/repositories.d/dc1-pmos.list

	# gdm autologin for the GNOME (systemd) desktop. Display orientation is
	# intentionally left to iio-sensor-proxy and mutter, which follow the
	# MC3416 accelerometer; a static monitors.xml would override that path.
	install -Dm644 "$srcdir"/gdm-custom.conf "$pkgdir"/etc/gdm/custom.conf

	# The only route from a running system back into LK's fastboot, and so
	# the only route back to flashing. See the source for the LK evidence.
	install -Dm755 "$srcdir"/dc1-reboot-fastboot \
		"$pkgdir"/usr/sbin/dc1-reboot-fastboot
	# On-device A/B slot control (the bootloader_control block in misc). This
	# is the mutation the initramfs bootctl dump tool retired, re-entered now
	# that the layout is pinned against real blocks; see dc1-slotctl.c.
	install -Dm755 "$srcdir"/dc1-slotctl \
		"$pkgdir"/usr/sbin/dc1-slotctl

	# Boot-image auto-sync: keep the flashed boot image in step with the
	# kernel apk over the A/B slots (download the release image, flash the
	# inactive slot, arm it, reboot). Runs once per boot as a oneshot; see
	# dc1-boot-sync and dc1-boot-sync.service.
	install -Dm755 "$srcdir"/dc1-boot-sync \
		"$pkgdir"/usr/libexec/dc1-boot-sync
	install -Dm644 "$srcdir"/dc1-boot-sync.service \
		"$pkgdir"/usr/lib/systemd/system/dc1-boot-sync.service
	# apk trigger script: apk runs it when /boot/vmlinuz or /usr/share/kernel/*
	# changes (i.e. a kernel package upgrade). Installed explicitly so it does
	# not depend on abuild auto-installing the $pkgname.trigger from $source.
	install -Dm755 "$srcdir"/device-daylight-jagar.trigger \
		"$pkgdir"/usr/share/apk/triggers/device-daylight-jagar.trigger
}

