#!/sbin/openrc-run
# Raise the DC-1 white frontlight once the compositor is up.
#
# The rt4539 frontlight boots at 0, so a correctly scanned-out frame is
# invisible and reads as a dead panel. It must come up only after a frame is
# composited, not on a stale/dark buffer. This first-light version waits for
# Sway to be running plus a short grace for its first frame; the rigorous
# visible-frame gate (an advancing OVL0 IRQ) is a later milestone.
#
# The amber channel is left alone on purpose.

description="Raise the DC-1 white frontlight after first light"

depend() {
	need dc1-display-gate
	after tinydm
}

start() {
	ebegin "Raising the DC-1 white frontlight"
	# Background the wait: openrc must not block the boot on this.
	(
		n=0
		while ! pidof sway >/dev/null 2>&1; do
			n=$((n + 1)); [ "$n" -ge 30 ] && break; sleep 1
		done
		sleep 3
		echo 10 > /sys/class/backlight/lcd-backlight/brightness 2>/dev/null
	) &
	eend 0
}
