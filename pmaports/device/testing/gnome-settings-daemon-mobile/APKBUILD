maintainer="Stefan Hansson <newbyte@postmarketos.org>"
pkgname=gnome-settings-daemon-mobile
pkgver=999951.1.21
pkgrel=0
pkgdesc="GNOME settings daemon"
url="https://gitlab.gnome.org/verdre/gnome-settings-daemon-mobile"
# armhf: pmb#2618
arch="aarch64"
options="!check" # tests fail on builders
license="GPL-2.0-only AND LGPL-2.1-only"
depends="pulseaudio $pkgname-systemd=$pkgver-r$pkgrel"
provides="gnome-settings-daemon=$pkgver-r$pkgrel"
depends_dev="
	alsa-lib-dev
	colord-dev
	cups-dev
	geoclue-dev
	geocode-glib-dev>=3.26.4-r1
	lcms2-dev
	libcanberra-dev
	libgweather4-dev
	libnotify-dev
	libwacom-dev
	modemmanager-dev
	networkmanager-dev
	nss-dev
	pango-dev
	polkit-dev
	pulseaudio-dev
	systemd-dev
	upower-dev
	"
makedepends="
	$depends_dev
	coreutils
	gcr4-dev
	glib-dev
	gnome-desktop-dev
	gsettings-desktop-schemas-dev
	gtk+3.0-dev
	libxml2-utils
	meson
	"
# checkdepends="
# 	gnome-session
# 	gnome-shell
# 	py3-dbusmock
# 	py3-gobject3
# 	umockdev-dev
# 	"
subpackages="
	$pkgname-dev
	$pkgname-lang
	$pkgname-systemd
	"
_commit="9898ab670852caf8f02dbba98183597fe61f6941"
source="
	gnome-settings-daemon-mobile-$_commit.tar.gz::https://gitlab.gnome.org/verdre/gnome-settings-daemon-mobile/-/archive/$_commit/gnome-settings-daemon-mobile-$_commit.tar.gz
	libgnome-volume-control-0a4eda0cdc2deb352bebc70ec697c42af46094e4.tar.gz::https://gitlab.gnome.org/GNOME/libgnome-volume-control/-/archive/0a4eda0cdc2deb352bebc70ec697c42af46094e4/libgnome-volume-control-0a4eda0cdc2deb352bebc70ec697c42af46094e4.tar.gz
	reflective-frontlight.patch
	"
builddir="$srcdir/gnome-settings-daemon-mobile-$_commit"

prepare() {
	default_prepare
	# Keep pkg-config versions numeric for all three matched components.
	sed -i 's/51\.1\.mobile\.21/51.1.21/g' meson.build
}

build() {
	rm -rf "$builddir/subprojects/gvc"
	mv "$srcdir/libgnome-volume-control-0a4eda0cdc2deb352bebc70ec697c42af46094e4" $builddir/subprojects/gvc
	abuild-meson \
		-Db_lto=true \
		-Dsystemd=true \
		. output
	meson compile -C output
}

dev() {
	provides="gnome-settings-daemon-dev=$pkgver-r$pkgrel"
	default_dev
}

systemd() {
	provides="gnome-settings-daemon-systemd=$pkgver-r$pkgrel"
	default_systemd
}

lang() {
	provides="gnome-settings-daemon-lang=$pkgver-r$pkgrel"
	default_lang
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


