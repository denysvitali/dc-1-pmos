# Only lib/, pubspec.yaml and analysis_options.yaml are committed. The
# linux/ runner is generated by `flutter create` inside the build chroot
# (scripts/build-flutter-ui.sh) and the bundle is a build artifact; a
# committed bundle would also trip scripts/verify.sh's *.bin tripwire.
build/
.dart_tool/
.idea/
*.iml
.packages
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
linux/
android/
ios/
web/
macos/
windows/
test/
